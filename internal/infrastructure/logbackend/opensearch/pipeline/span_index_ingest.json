curl -X PUT "http://localhost:9200/_ingest/pipeline/otel_span_ingest_v1" -H 'Content-Type: application/json' -d @pipeline.json


curl -X PUT "http://localhost:9200/_ingest/pipeline/otel_span_ingest_v1" -H 'Content-Type: application/json' -d '{
  "description": "OTLP span -> indexable fields for app-log-otel-span-*",
  "processors": [
    {
      "script": {
        "description": "time fields: start/end ISO8601 for date_nanos, duration",
        "lang": "painless",
        "source": """
          // helper: to ISO8601 with nanos (truncate to millis to be safe with date_nanos parsing)
          String toIsoFromNanos(def nanos) {
            if (nanos == null) return null;
            long ms = (long)(nanos / 1_000_000L);
            return Instant.ofEpochMilli(ms).toString(); // e.g. 2025-11-09T00:00:00Z
          }

          // start/end
          if (ctx.containsKey('startTimeUnixNano') && ctx.startTimeUnixNano != null) {
            ctx.startTime = toIsoFromNanos(ctx.startTimeUnixNano);
          }
          if (ctx.containsKey('endTimeUnixNano') && ctx.endTimeUnixNano != null) {
            ctx.endTime = toIsoFromNanos(ctx.endTimeUnixNano);
          }

          // duration
          if (!ctx.containsKey('durationNano') || ctx.durationNano == null) {
            if (ctx.containsKey('startTimeUnixNano') && ctx.containsKey('endTimeUnixNano')
                && ctx.startTimeUnixNano != null && ctx.endTimeUnixNano != null) {
              ctx.durationNano = (long)(ctx.endTimeUnixNano - ctx.startTimeUnixNano);
            }
          }

          // ensure containers
          if (!ctx.containsKey('attributes_map')) ctx.attributes_map = new HashMap();
          if (!ctx.containsKey('resource')) ctx.resource = new HashMap();
          if (!ctx.resource.containsKey('service')) ctx.resource.service = new HashMap();
          if (!ctx.resource.service.containsKey('instance')) ctx.resource.service.instance = new HashMap();
          if (!ctx.resource.containsKey('telemetry')) ctx.resource.telemetry = new HashMap();
          if (!ctx.resource.telemetry.containsKey('sdk')) ctx.resource.telemetry.sdk = new HashMap();
        """
      }
    },

    {
      "script": {
        "description": "attributes -> attributes_map (.i/.f/.b/.s); supports OTLP array or plain map",
        "lang": "painless",
        "source": """
          // put key with typed suffix into dest map
          void putTyped(def dest, String k, def v) {
            if (v == null) return;
            if (v instanceof Boolean)      { dest[k + '.b'] = v; return; }
            if (v instanceof Number) {
              if (v instanceof Float || v instanceof Double || v instanceof BigDecimal) {
                dest[k + '.f'] = v;
              } else {
                // treat integral as long
                dest[k + '.i'] = (v.longValue());
              }
              return;
            }
            // fallback string
            dest[k + '.s'] = v.toString();
          }

          // OTLP style: attributes: [{key, value:{stringValue|boolValue|intValue|doubleValue|arrayValue|kvlistValue}}]
          void foldOtlpArray(def src, def dest) {
            for (def a : src) {
              if (a == null || !a.containsKey('key') || !a.containsKey('value')) continue;
              String k = a.key;
              def val = a.value;

              if (val.containsKey('stringValue')) { putTyped(dest, k, val.stringValue); continue; }
              if (val.containsKey('boolValue'))   { putTyped(dest, k, val.boolValue);   continue; }
              if (val.containsKey('intValue'))    { putTyped(dest, k, val.intValue);    continue; }
              if (val.containsKey('doubleValue')) { putTyped(dest, k, val.doubleValue); continue; }

              // arrays/kvlist は文字列化（必要に応じて拡張）
              if (val.containsKey('arrayValue') || val.containsKey('kvlistValue')) {
                putTyped(dest, k, val.toString());
              }
            }
          }

          // plain map style
          void foldMap(def src, def dest) {
            for (def e : src.entrySet()) {
              putTyped(dest, e.getKey(), e.getValue());
            }
          }

          if (ctx.containsKey('attributes') && ctx.attributes != null) {
            def am = ctx.attributes_map;
            if (ctx.attributes instanceof List) {
              foldOtlpArray(ctx.attributes, am);
            } else if (ctx.attributes instanceof Map) {
              foldMap(ctx.attributes, am);
            }
          }
        """
      }
    },

    {
      "foreach": {
        "field": "events",
        "processor": {
          "script": {
            "description": "events[*]: timeUnixNano -> time (ISO); attributes -> attributes_map",
            "lang": "painless",
            "source": """

              String toIsoFromNanos(def nanos) {
                if (nanos == null) return null;
                long ms = (long)(nanos / 1_000_000L);
                return Instant.ofEpochMilli(ms).toString();
              }

              void putTyped(def dest, String k, def v) {
                if (v == null) return;
                if (v instanceof Boolean)      { dest[k + '.b'] = v; return; }
                if (v instanceof Number) {
                  if (v instanceof Float || v instanceof Double || v instanceof BigDecimal) {
                    dest[k + '.f'] = v;
                  } else {
                    dest[k + '.i'] = (v.longValue());
                  }
                  return;
                }
                dest[k + '.s'] = v.toString();
              }

              void foldOtlpArray(def src, def dest) {
                for (def a : src) {
                  if (a == null || !a.containsKey('key') || !a.containsKey('value')) continue;
                  String k = a.key;
                  def val = a.value;

                  if (val.containsKey('stringValue')) { putTyped(dest, k, val.stringValue); continue; }
                  if (val.containsKey('boolValue'))   { putTyped(dest, k, val.boolValue);   continue; }
                  if (val.containsKey('intValue'))    { putTyped(dest, k, val.intValue);    continue; }
                  if (val.containsKey('doubleValue')) { putTyped(dest, k, val.doubleValue); continue; }
                  if (val.containsKey('arrayValue') || val.containsKey('kvlistValue')) {
                    putTyped(dest, k, val.toString());
                  }
                }
              }

              void foldMap(def src, def dest) {
                for (def e : src.entrySet()) {
                  putTyped(dest, e.getKey(), e.getValue());
                }
              }

              if (ctx.containsKey('timeUnixNano') && ctx.timeUnixNano != null) {
                ctx.time = toIsoFromNanos(ctx.timeUnixNano);
              }

              if (!ctx.containsKey('attributes_map')) ctx.attributes_map = new HashMap();

              if (ctx.containsKey('attributes') && ctx.attributes != null) {
                if (ctx.attributes instanceof List) {
                  foldOtlpArray(ctx.attributes, ctx.attributes_map);
                } else if (ctx.attributes instanceof Map) {
                  foldMap(ctx.attributes, ctx.attributes_map);
                }
              }
            """
          }
        },
        "ignore_missing": true
      }
    },

    {
      "foreach": {
        "field": "links",
        "processor": {
          "script": {
            "description": "links[*]: attributes -> attributes_map (linksはobject/dynamic:true)",
            "lang": "painless",
            "source": """
              void putTyped(def dest, String k, def v) {
                if (v == null) return;
                if (v instanceof Boolean)      { dest[k + '.b'] = v; return; }
                if (v instanceof Number) {
                  if (v instanceof Float || v instanceof Double || v instanceof BigDecimal) {
                    dest[k + '.f'] = v;
                  } else {
                    dest[k + '.i'] = (v.longValue());
                  }
                  return;
                }
                dest[k + '.s'] = v.toString();
              }
              void foldOtlpArray(def src, def dest) {
                for (def a : src) {
                  if (a == null || !a.containsKey('key') || !a.containsKey('value')) continue;
                  String k = a.key;
                  def val = a.value;

                  if (val.containsKey('stringValue')) { putTyped(dest, k, val.stringValue); continue; }
                  if (val.containsKey('boolValue'))   { putTyped(dest, k, val.boolValue);   continue; }
                  if (val.containsKey('intValue'))    { putTyped(dest, k, val.intValue);    continue; }
                  if (val.containsKey('doubleValue')) { putTyped(dest, k, val.doubleValue); continue; }
                  if (val.containsKey('arrayValue') || val.containsKey('kvlistValue')) {
                    putTyped(dest, k, val.toString());
                  }
                }
              }
              void foldMap(def src, def dest) {
                for (def e : src.entrySet()) {
                  putTyped(dest, e.getKey(), e.getValue());
                }
              }

              if (!ctx.containsKey('attributes_map')) ctx.attributes_map = new HashMap();
              if (ctx.containsKey('attributes') && ctx.attributes != null) {
                if (ctx.attributes instanceof List) {
                  foldOtlpArray(ctx.attributes, ctx.attributes_map);
                } else if (ctx.attributes instanceof Map) {
                  foldMap(ctx.attributes, ctx.attributes_map);
                }
              }
            """
          }
        },
        "ignore_missing": true
      }
    },

    {
      "script": {
        "description": "resource.attributes -> resource.service.*, resource.telemetry.sdk.*",
        "lang": "painless",
        "source": """
          // extract from resource.attributes (array or map)
          def r = ctx.resource;
          def targetKeys = new HashMap();
          // OTLP canonical keys
          targetKeys.put('service.name',        'service.name');
          targetKeys.put('service.namespace',   'service.namespace');
          targetKeys.put('service.instance.id', 'service.instance.id');
          targetKeys.put('service.version',     'service.version');
          targetKeys.put('telemetry.sdk.name',     'telemetry.sdk.name');
          targetKeys.put('telemetry.sdk.version',  'telemetry.sdk.version');
          targetKeys.put('telemetry.sdk.language', 'telemetry.sdk.language');

          // read both styles
          def kv = new HashMap();

          if (r.containsKey('attributes') && r.attributes != null) {
            if (r.attributes instanceof List) {
              for (def a : r.attributes) {
                if (a == null || !a.containsKey('key') || !a.containsKey('value')) continue;
                String k = a.key;
                def val = a.value;
                def outVal = null;
                if (val.containsKey('stringValue')) outVal = val.stringValue;
                else if (val.containsKey('boolValue')) outVal = val.boolValue;
                else if (val.containsKey('intValue')) outVal = val.intValue;
                else if (val.containsKey('doubleValue')) outVal = val.doubleValue;
                else outVal = val.toString();
                kv.put(k, outVal);
              }
            } else if (r.attributes instanceof Map) {
              for (def e : r.attributes.entrySet()) {
                kv.put(e.getKey(), e.getValue());
              }
            }
          }

          // write into structured fields if present
          def s = r.service; def inst = r.service.instance; def sdk = r.telemetry.sdk;
          if (kv.containsKey('service.name'))        s.name = kv.get('service.name');
          if (kv.containsKey('service.namespace'))   s.namespace = kv.get('service.namespace');
          if (kv.containsKey('service.instance.id')) inst.id = kv.get('service.instance.id');
          if (kv.containsKey('service.version'))     s.version = kv.get('service.version');

          if (kv.containsKey('telemetry.sdk.name'))     sdk.name = kv.get('telemetry.sdk.name');
          if (kv.containsKey('telemetry.sdk.version'))  sdk.version = kv.get('telemetry.sdk.version');
          if (kv.containsKey('telemetry.sdk.language')) sdk.language = kv.get('telemetry.sdk.language');
        """
      }
    }
  ],
  "on_failure": [
    { "set": { "field": "ingest_error", "value": "{{ _ingest.on_failure_message }}" } }
  ]
}'
