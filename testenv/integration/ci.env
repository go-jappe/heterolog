# CI専用の結合テスト設定です（HETEROLOG_INTEGRATION_ENV_PATHで指定します）。
# testenv/integration/start-services.shが起動する使い捨てcontainerだけを宛先にします。
# 本番・共有環境の宛先や認証情報を書かないでください。ここにある値は秘密情報ではありません。
#
# 開発者がローカルで既定port（9200・3100・8123・4317など）のserviceを動かしていても
# 誤って書き込まないよう、CI専用のport帯（2xxxx）を使い、127.0.0.1だけで公開します。
# start-services.shはこのfileの宛先から公開するportを決めるため、portはここだけで変更できます。
#
# 試験中は、このfileにない設定項目をprocess環境から外します。scriptも値を読み出すため、
# 値は1行で書き、変数展開やescapeを使わないでください。

HETEROLOG_APP_NAME=heterolog-ci
HETEROLOG_APP_ENV=ci
HETEROLOG_TARGET=heterolog-ci

# HETEROLOG_LOG_TYPEは指定しません（既定の標準出力）。backendの試験は試験対象のbackendでHETEROLOG_LOG_TYPEを
# 上書きします。非同期・Delivery loggerも既定の標準出力のままです。

# 既定のtimeout budget policy（must_fit）では、loggerのtimeoutがclientのretry予算
# （client timeout×試行回数と待機の合計）を上回る必要があります。既定値（logger 18s、
# OpenSearch 1s、Loki・ClickHouse 2s）のままでも予算はOpenSearch 17s・Loki 8s・
# ClickHouse 8sで検証を通ります。ここでは起動直後のcontainerに合わせてOpenSearchの
# client timeoutを2sにするため、その予算（9×HETEROLOG_OPENSEARCH_TIMEOUT_SECOND+8s＝26s）を
# 上回る30sを指定します。
HETEROLOG_LOG_TIMEOUT_SECOND=30

# OpenSearch: containerはsecurity pluginを無効にしているため、認証なしで接続します。
# 起動直後のcontainerがindexを自動作成する初回requestに余裕を持たせ、2秒にします。
HETEROLOG_OPENSEARCH_ENDPOINT=http://127.0.0.1:29200
HETEROLOG_OPENSEARCH_AUTH_TYPE=none
HETEROLOG_OPENSEARCH_TIMEOUT_SECOND=2
HETEROLOG_OPENSEARCH_INDEX=app-log-heterolog-ci
# pkg/opensearchの試験が書き込むindexです（app-logで始まる必要があります）。
OPENSEARCH_TEST_INDEX=app-log-heterolog-ci-client

# Loki: containerの既定設定（認証なし・single tenant）に送信します。
HETEROLOG_LOKI_ENDPOINT=http://127.0.0.1:23100

# ClickHouse: 試験がdatabaseとtableを作成します。利用者とpasswordは使い捨ての値で、
# start-services.shはこの値でcontainerの利用者を作成します（default利用者は使いません）。
HETEROLOG_CLICKHOUSE_ENDPOINT=http://127.0.0.1:28123
HETEROLOG_CLICKHOUSE_DATABASE=heterolog_ci
HETEROLOG_CLICKHOUSE_TABLE=app_logs
HETEROLOG_CLICKHOUSE_USERNAME=heterolog_ci
HETEROLOG_CLICKHOUSE_PASSWORD=ci-only-throwaway-password

# Tempo: file loggerの試験はOTLP gRPCでTempoへspanを直接送信します。
HETEROLOG_OTEL_TEMPO_ADDR=127.0.0.1:24317

# OpenTelemetry Collector: OTLP gRPCで受信し、Tempoへ転送します。
HETEROLOG_OTEL_COLLECTOR_ADDR=127.0.0.1:25317
