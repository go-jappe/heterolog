# Credentials are intentionally empty. Configure them only when enabling a remote backend.
# The default output is stdout; no external service is required.
# Every key starts with HETEROLOG_, so the file and the environment can also hold the application's own settings.

# アプリ名称
HETEROLOG_APP_NAME=heterolog
HETEROLOG_APP_ENV=dev
# アプリ識別名 dirnameなどに使用
HETEROLOG_TARGET=heterolog
# ログの出力先(カンマ区切り) 
# 設定可能値 'file', 'stdout', 'slack', 'opensearch', 'loki', 'cloudwatchlogs', 'clickhouse'
# 未設定・空の場合はstdoutだけを使います（HETEROLOG_ASYNC_LOG_TYPE・HETEROLOG_DELIVERY_LOG_TYPEも同じ）。
# slackは明示した場合だけ有効になり、HETEROLOG_SLACK_API_KEYがなければ設定エラーになります。
HETEROLOG_LOG_TYPE=stdout
# 1回のログ出力の上限（秒）。未設定時も18秒です。must_fitでは、選択した各出力先のclientの
# 再試行を含む予算（timeout×試行回数＋待機）より長くする必要があります。各clientの既定値は
# 未設定時の予算がこの値に収まるように決めています（ASYNC_・DELIVERY_も同じ）。
HETEROLOG_LOG_TIMEOUT_SECOND=18
# timeout budget policy: must_fit, may_cutoff, unbounded
HETEROLOG_LOG_TIMEOUT_BUDGET_POLICY=must_fit
# 非同期ロガー出力先設定可能値 'file', 'stdout', 'slack', 'opensearch', 'loki', 'cloudwatchlogs', 'clickhouse'
# 未設定・空の場合はstdoutだけを使います。slackを指定する場合はHETEROLOG_ASYNC_SLACK_API_KEYが必須です。
HETEROLOG_ASYNC_LOG_TYPE=stdout
# 未設定時も18秒です。
HETEROLOG_ASYNC_LOG_TIMEOUT_SECOND=18
# timeout budget policy: must_fit, may_cutoff, unbounded
HETEROLOG_ASYNC_LOG_TIMEOUT_BUDGET_POLICY=must_fit
# 非同期ベストエフォートMultiLoggerの同時実行（送信）上限数。
# 上限に達した場合、実行中の送信が完了して空きができるまで後続ログの受付を待機させます。
# 上限到達を理由にログや送信先を破棄しません。
# 小さくするとI/O・CPU・各送信先への負荷を抑えられますが、受付の待機が発生しやすくなります。
# 大きくするとスループットは上がりますが、FD・CPU・各送信先の負荷が増加します。
# 目安は16〜128で、64を標準的な初期値とします。
HETEROLOG_MAX_ASYNC_LOG_PARALLEL=64
#送達確認ロガー出力先設定可能値 'file', 'stdout', 'slack', 'opensearch', 'loki', 'cloudwatchlogs', 'clickhouse'
# Delivery本体は同期・一件送信です。SlackはHTTP応答や通知側の処理で遅くなる可能性が
# あるため、低遅延が必要なDelivery出力先としては非推奨です。
# 未設定・空の場合はstdoutだけを使います。slackを指定する場合はHETEROLOG_DELIVERY_SLACK_API_KEYが必須です。
HETEROLOG_DELIVERY_LOG_TYPE=stdout
# 未設定時も12秒です。
HETEROLOG_DELIVERY_LOG_TIMEOUT_SECOND=12
# timeout budget policy: must_fit, may_cutoff, unbounded
HETEROLOG_DELIVERY_LOG_TIMEOUT_BUDGET_POLICY=must_fit
# 1回に渡せるログ（message、error、fields）の上限（バイト）。
# JSONとして数え、超過したログは切り詰めずに拒否します。未設定時は1 MiBです。
HETEROLOG_MAX_LOG_ENTRY_BYTES=1048576
# 出力するログレベル 'DEBUG', 'INFO', 'WARN', 'ERROR', 'FATAL'
# 未設定時は、SlackがERROR、ほかの出力先はINFOです（ASYNC_も同じ。DELIVERY_ではSlackだけがレベルを持ち、ERRORです）。
HETEROLOG_FILE_LOG_LEVEL=INFO
HETEROLOG_STDOUT_LOG_LEVEL=INFO
HETEROLOG_SLACK_LOG_LEVEL=ERROR
HETEROLOG_ASYNC_SLACK_LOG_LEVEL=ERROR
HETEROLOG_DELIVERY_SLACK_LOG_LEVEL=ERROR
HETEROLOG_OPENSEARCH_LOG_LEVEL=INFO
HETEROLOG_ASYNC_OPENSEARCH_LOG_LEVEL=INFO
# 非同期ロガーに出力するログレベル 'DEBUG', 'INFO', 'WARN', 'ERROR', 'FATAL'
HETEROLOG_ASYNC_FILE_LOG_LEVEL=INFO
# trueならUTCではなくHETEROLOG_TIMEZONE_LOGのタイムゾーンで時刻を記載（対象はログのみ）
# 未設定時はfalseで、公開APIのDefaultConfigと同じくUTCで記録します。
HETEROLOG_ENABLE_LOCAL_TIME_LOG=false
# HETEROLOG_ENABLE_LOCAL_TIME_LOG=trueの場合に使うタイムゾーン（対象はログのみ）。未設定時はUTCです。
HETEROLOG_TIMEZONE_LOG="Asia/Tokyo"

#Health
#Memory
# HETEROLOG_USE_MEMORY_PRESSURE_*_SPOOL_OVERLOAD=trueにしたspoolは、OSのメモリを1秒ごとに取得し、
# 次の閾値で過負荷を判定します。WithMemoryPressureMonitorで監視器を渡した場合は、その判定を使います。
# 使用率がRATIO以上か、利用可能なメモリがMIN_AVAILABLE以下の取得を過負荷の候補とし、
# 候補がCONSECUTIVE_HITS回続いたら過負荷として扱います。
# メモリ使用率の割合（0より大きく1以下）
HETEROLOG_MEMORY_CRITICAL_RATIO=0.9
# 利用可能なメモリの量（MiB単位、1以上）
HETEROLOG_MIN_AVAILABLE_MEMORY_BYTES_MB=256
# 過負荷とするまでに続く候補の回数（1以上）
HETEROLOG_MEMORY_CRITICAL_CONSECUTIVE_HITS=3

# 使用するログ通知・ツール
HETEROLOG_ENABLE_LOGGING=true
HETEROLOG_ENABLE_ASYNC_BEST_EFFORT_LOGGING=true
HETEROLOG_ENABLE_DELIVERY_LOGGING=true
HETEROLOG_ENABLE_OPENSEARCH=true
HETEROLOG_ENABLE_ASYNC_OPENSEARCH=true

# 最大ログサイズ(MB) 1ファイルあたり
HETEROLOG_MAX_LOG_SIZE_MB=25
# ログ保存先ディレクトリ名（HETEROLOG_SYSTEM_LOG_DIRとHETEROLOG_TARGETを基準に解決）
HETEROLOG_LOG_DIR=/logs
HETEROLOG_ERROR_LOG_DIR=/error_logs
# DEBUGログのdirectory分離。ファイル名の分離スイッチとは独立しています。
# falseならHETEROLOG_DEBUG_LOG_DIRの値を無視してHETEROLOG_LOG_DIRを使用します。
# trueなら空白だけでないHETEROLOG_DEBUG_LOG_DIRが必要です。
HETEROLOG_ENABLE_LOG_FILE_SEPARATE_DEBUG_LOG_DIR=false
# ERROR/DEBUGを両方分離する場合、両者の保存先を同じにできるのはHETEROLOG_LOG_DIRも同じ場合だけです。
HETEROLOG_DEBUG_LOG_DIR=
# エラーログの出力先ファイル名を変更する
HETEROLOG_ENABLE_LOG_FILE_SEPARATE_ERROR_LOGS=true
# デバッグーログの出力先ファイル名を変更する
HETEROLOG_ENABLE_LOG_FILE_SEPARATE_DEBUG_LOGS=true
# ログファイルのローテーションの頻度 'daily', 'weekly', 'monthly'のいずれかを指定
# 'weekly'は、UTCの日曜日0時から新しいファイルに切り替えます。
# 無効な値もしくは未指定の場合は、デフォルト値が適用されます
HETEROLOG_LOG_FILE_ROTATION=daily

# 最大ログサイズ(MB) 1ファイルあたり
HETEROLOG_MAX_ASYNC_LOG_SIZE_MB=25
# ログ保存先ディレクトリ名（HETEROLOG_SYSTEM_LOG_DIRとHETEROLOG_TARGETを基準に解決）
HETEROLOG_ASYNC_LOG_DIR=/async_logs
HETEROLOG_ASYNC_ERROR_LOG_DIR=/async_logs_error
# DEBUGログのdirectory分離。ファイル名の分離スイッチとは独立しています。
# falseならHETEROLOG_ASYNC_DEBUG_LOG_DIRの値を無視してHETEROLOG_ASYNC_LOG_DIRを使用します。
# trueなら空白だけでないHETEROLOG_ASYNC_DEBUG_LOG_DIRが必要です。
HETEROLOG_ENABLE_ASYNC_LOG_FILE_SEPARATE_DEBUG_LOG_DIR=false
# ERROR/DEBUGを両方分離する場合、両者の保存先を同じにできるのはHETEROLOG_ASYNC_LOG_DIRも同じ場合だけです。
HETEROLOG_ASYNC_DEBUG_LOG_DIR=
# エラーログの出力先ファイル名を変更する
HETEROLOG_ENABLE_ASYNC_LOG_FILE_SEPARATE_ERROR_LOGS=true
# デバッグーログの出力先ファイル名を変更する
HETEROLOG_ENABLE_ASYNC_LOG_FILE_SEPARATE_DEBUG_LOGS=true
# ログファイルのローテーションの頻度 'daily', 'weekly', 'monthly'のいずれかを指定
# 'weekly'は、UTCの日曜日0時から新しいファイルに切り替えます。
# 無効な値もしくは未指定の場合は、デフォルト値が適用されます
HETEROLOG_ASYNC_LOG_FILE_ROTATION=daily

#最大ログサイズ(MB) 1ファイルあたり。1以上を指定します（通常ログと同じ下限です）。
HETEROLOG_MAX_DELIVERY_LOG_SIZE_MB=25
# ログ保存先ディレクトリ名（HETEROLOG_SYSTEM_LOG_DIRとHETEROLOG_TARGETを基準に解決）
HETEROLOG_DELIVERY_LOG_DIR=/delivery_logs
HETEROLOG_DELIVERY_ERROR_LOG_DIR=/delivery_logs_error
# DEBUGログのdirectory分離。ファイル名の分離スイッチとは独立しています。
# falseならHETEROLOG_DELIVERY_DEBUG_LOG_DIRの値を無視してHETEROLOG_DELIVERY_LOG_DIRを使用します。
# trueなら空白だけでないHETEROLOG_DELIVERY_DEBUG_LOG_DIRが必要です。
HETEROLOG_ENABLE_DELIVERY_LOG_FILE_SEPARATE_DEBUG_LOG_DIR=false
# ERROR/DEBUGを両方分離する場合、両者の保存先を同じにできるのはHETEROLOG_DELIVERY_LOG_DIRも同じ場合だけです。
HETEROLOG_DELIVERY_DEBUG_LOG_DIR=
#エラーログの出力先ファイル名を変更する
HETEROLOG_ENABLE_DELIVERY_LOG_FILE_SEPARATE_ERROR_LOGS=true
#デバッグーログの出力先ファイル名を変更する
HETEROLOG_ENABLE_DELIVERY_LOG_FILE_SEPARATE_DEBUG_LOGS=true
#ログファイルのローテーションの頻度 'daily', 'weekly', 'monthly'のいずれかを指定
# 'weekly'は、UTCの日曜日0時から新しいファイルに切り替えます。
#無効な値もしくは未指定の場合は、デフォルト値が適用されます
HETEROLOG_DELIVERY_LOG_FILE_ROTATION=daily

# ローグローテーション有効化設定
HETEROLOG_ENABLE_LOG_FILE_ROTATE=true
# ログ保持最大世代数
HETEROLOG_MAX_LOG_FILE_BACKUPS=60
# ログファイル最大保持日数
HETEROLOG_MAX_LOG_FILE_AGE=60
# ログディレクトリ 合計ファイル最大サイズ(MB) 閾値を超えると古い順に削除
HETEROLOG_MAX_LOG_FILE_DIR_SIZE_MB=128
# error/debugログの保持上限。未設定または空欄は各項目の共通設定を継承します。
# 明示した0・負数は継承に置き換えず、通常の型・値の検証対象になります。
# 使用する値は世代数2以上、日数1以上、容量10MiB以上かつ最大ログファイルサイズ以上が必要です。
# lifecycle無効・該当ログ分離無効なら値の範囲検証は省略しますが、数値の書式は検証します。
# 世代数・日数は保持の上限であり、容量制限によりそれ以前に削除される場合があります。
# errorログの最大保持世代数。未設定・空欄はHETEROLOG_MAX_LOG_FILE_BACKUPSを継承。
HETEROLOG_MAX_ERROR_LOG_FILE_BACKUPS=
# errorログの最大保持日数。未設定・空欄はHETEROLOG_MAX_LOG_FILE_AGEを継承。
HETEROLOG_MAX_ERROR_LOG_FILE_AGE=
# errorログのディレクトリ容量上限(MB)。未設定・空欄はHETEROLOG_MAX_LOG_FILE_DIR_SIZE_MBを継承。
# 通常ログと同じディレクトリの場合、この専用容量は使わず共通容量でディレクトリ全体を制限します。
HETEROLOG_MAX_ERROR_LOG_FILE_DIR_SIZE_MB=
# debugログの最大保持世代数。未設定・空欄はHETEROLOG_MAX_LOG_FILE_BACKUPSを継承。
HETEROLOG_MAX_DEBUG_LOG_FILE_BACKUPS=
# debugログの最大保持日数。未設定・空欄はHETEROLOG_MAX_LOG_FILE_AGEを継承。
HETEROLOG_MAX_DEBUG_LOG_FILE_AGE=
# debugログのディレクトリ容量上限(MB)。未設定・空欄はHETEROLOG_MAX_LOG_FILE_DIR_SIZE_MBを継承。
# 通常ログと同じディレクトリの場合、この専用容量は使わず共通容量でディレクトリ全体を制限します。
HETEROLOG_MAX_DEBUG_LOG_FILE_DIR_SIZE_MB=
# ログローテート時に古いファイルを圧縮
HETEROLOG_ENABLE_LOG_FILE_COMPRESS=true
# gzip or zstd or lz4 or xz
HETEROLOG_LOG_COMPRESS_FORMAT=gzip
# ローテーション済みログの圧縮・アーカイブアップロード・パージをどこで実行するか
# disable=実行しない, inline=FileLoggerの書き込み経路で実行, runner=専用goroutineのappendlog lifecycle runnerが定期実行
HETEROLOG_LOG_FILE_LIFECYCLE_MODE=inline
# 空き容量がHETEROLOG_MIN_AVAILABLE_DISK_SPACE_GB未満の場合: drop=破棄、degrade=stdoutへ退避。
# 閾値が0なら容量判定なし。SECONDARY_DESTINATIONはdegrade時だけ使用し、stdoutのみ対応。
HETEROLOG_LOG_FILE_OVERLOAD_POLICY=drop
HETEROLOG_LOG_FILE_SECONDARY_DESTINATION=stdout
# appendlog lifecycle runnerのlevel別internal log委譲先。空なlevelは記録しない。
# purge失敗はWARNへ格下げせずERRORへ委譲する。
# `file`、`stdout`、`slack`、`opensearch`、`loki`、`cloudwatchlogs`、
# `clickhouse`のbare backend名を指定する。
HETEROLOG_LOG_FILE_LIFECYCLE_ERROR_HANDLER=
HETEROLOG_LOG_FILE_LIFECYCLE_WARN_HANDLER=
HETEROLOG_LOG_FILE_LIFECYCLE_INFO_HANDLER=
HETEROLOG_LOG_FILE_LIFECYCLE_DEBUG_HANDLER=
# sync logger内で発生する全internal log共通の保存先identity上書き。
# appendlog lifecycle、backend送信、failure store、spoolなどのinternal logに適用する。
# 実際の委譲先は各*_HANDLERで選び、ここへの値の指定だけではbackendを起動しない。
# 空文字の設定項目とtimeout、retry、認証は通常backend設定を継承する。
# Slackの共通channelだけ指定しても、通常backendのレベル別channelは引き継ぐ。
# Loki labelsは未設定/nullなら継承、{}なら追加labelを消去し、指定mapは全置換する。
# appName/loglevel/envはlogger生成値を維持。不正なlabel名は使用する保存先の起動時検証でエラーにする。
HETEROLOG_LOG_INTERNAL_LOG_FILE_LOG_PATH=
HETEROLOG_LOG_INTERNAL_LOG_FILE_TARGET=
HETEROLOG_LOG_INTERNAL_LOG_FILE_LOG_DIR=
HETEROLOG_LOG_INTERNAL_LOG_FILE_ERROR_LOG_DIR=
# 空なら通常のHETEROLOG_ENABLE_LOG_FILE_SEPARATE_DEBUG_LOG_DIRを継承し、true/falseなら上書きします。
# falseならDEBUG保存先の値を無視してinternal logのHETEROLOG_LOG_DIRを使用します。
HETEROLOG_LOG_INTERNAL_LOG_FILE_SEPARATE_DEBUG_LOG_DIR=
# 分離がtrueのときだけ使用します。空なら通常のHETEROLOG_DEBUG_LOG_DIRを継承し、継承後も空白だけならエラーです。
# このpathの有無ではdirectory分離を切り替えません。DEBUGファイル名の分離設定は通常backendを継承します。
# 継承・上書き後のinternal logでも、defaultとは別の保存先をERROR/DEBUGだけで共有する設定は拒否します。
HETEROLOG_LOG_INTERNAL_LOG_FILE_DEBUG_LOG_DIR=
HETEROLOG_LOG_INTERNAL_LOG_SLACK_CHANNEL=
HETEROLOG_LOG_INTERNAL_LOG_SLACK_ERROR_CHANNEL=
HETEROLOG_LOG_INTERNAL_LOG_SLACK_WARN_CHANNEL=
HETEROLOG_LOG_INTERNAL_LOG_SLACK_INFO_CHANNEL=
HETEROLOG_LOG_INTERNAL_LOG_SLACK_DEBUG_CHANNEL=
HETEROLOG_LOG_INTERNAL_LOG_OPENSEARCH_INDEX=
# JSON object。例: {"event_scope":"logger_internal"}
HETEROLOG_LOG_INTERNAL_LOG_LOKI_LABELS=
HETEROLOG_LOG_INTERNAL_LOG_CLOUDWATCH_LOG_GROUP_NAME=
HETEROLOG_LOG_INTERNAL_LOG_CLOUDWATCH_LOG_STREAM_NAME=
HETEROLOG_LOG_INTERNAL_LOG_CLICKHOUSE_DATABASE=
HETEROLOG_LOG_INTERNAL_LOG_CLICKHOUSE_TABLE=
# 1回の通知につき送信されるログ数
HETEROLOG_MAX_LOGS_PER_SLACK_NOTIFICATION=10
HETEROLOG_MAX_ASYNC_LOGS_PER_SLACK_NOTIFICATION=10
# Slack通知が途切れた後に待機時間を初期化するまでの無通知時間（分、1以上）
HETEROLOG_MAX_SLACK_REST_THRESHOLD_MINUTE=360
HETEROLOG_MAX_ASYNC_SLACK_REST_THRESHOLD_MINUTE=360
# 初回の即時通知後、Slackのbuffer送信を順に遅延させる待機時間（分、各要素は1以上）
HETEROLOG_SLACK_INTERVALS=1,5,30,60,120,240
HETEROLOG_ASYNC_SLACK_INTERVALS=1,5,30,60,120,240

# 同期ログローテーション有効化設定
HETEROLOG_ENABLE_ASYNC_LOG_FILE_ROTATE=true
# 同期ログ保持最大世代数
HETEROLOG_MAX_ASYNC_LOG_FILE_BACKUPS=60
# 同期ログファイル最大保持日数
HETEROLOG_MAX_ASYNC_LOG_FILE_AGE=60
# 同期ログディレクトリ 合計ファイル最大サイズ(MB) 閾値を超えると古い順に削除
HETEROLOG_MAX_ASYNC_LOG_FILE_DIR_SIZE_MB=2048
# 非同期error/debugログの保持上限。未設定または空欄は各項目の共通設定を継承します。
# 明示した0・負数は継承に置き換えず、通常の型・値の検証対象になります。
# 使用する値は世代数2以上、日数1以上、容量10MiB以上かつ最大ログファイルサイズ以上が必要です。
# lifecycle無効・該当ログ分離無効なら値の範囲検証は省略しますが、数値の書式は検証します。
# 世代数・日数は保持の上限であり、容量制限によりそれ以前に削除される場合があります。
# errorログの最大保持世代数。未設定・空欄はHETEROLOG_MAX_ASYNC_LOG_FILE_BACKUPSを継承。
HETEROLOG_MAX_ASYNC_ERROR_LOG_FILE_BACKUPS=
# errorログの最大保持日数。未設定・空欄はHETEROLOG_MAX_ASYNC_LOG_FILE_AGEを継承。
HETEROLOG_MAX_ASYNC_ERROR_LOG_FILE_AGE=
# errorログのディレクトリ容量上限(MB)。未設定・空欄はHETEROLOG_MAX_ASYNC_LOG_FILE_DIR_SIZE_MBを継承。
# 通常ログと同じディレクトリの場合、この専用容量は使わず共通容量でディレクトリ全体を制限します。
HETEROLOG_MAX_ASYNC_ERROR_LOG_FILE_DIR_SIZE_MB=
# debugログの最大保持世代数。未設定・空欄はHETEROLOG_MAX_ASYNC_LOG_FILE_BACKUPSを継承。
HETEROLOG_MAX_ASYNC_DEBUG_LOG_FILE_BACKUPS=
# debugログの最大保持日数。未設定・空欄はHETEROLOG_MAX_ASYNC_LOG_FILE_AGEを継承。
HETEROLOG_MAX_ASYNC_DEBUG_LOG_FILE_AGE=
# debugログのディレクトリ容量上限(MB)。未設定・空欄はHETEROLOG_MAX_ASYNC_LOG_FILE_DIR_SIZE_MBを継承。
# 通常ログと同じディレクトリの場合、この専用容量は使わず共通容量でディレクトリ全体を制限します。
HETEROLOG_MAX_ASYNC_DEBUG_LOG_FILE_DIR_SIZE_MB=
# 同期ログローテート時に古いファイルを圧縮
HETEROLOG_ENABLE_ASYNC_LOG_FILE_COMPRESS=true
# 同期ログ圧縮形式 gzip or zstd or lz4 or xz
HETEROLOG_ASYNC_LOG_COMPRESS_FORMAT=gzip
# ローテーション済み非同期ログの圧縮・アーカイブアップロード・パージをどこで実行するか
# disable=実行しない, inline=FileLoggerの書き込み経路で実行, runner=専用goroutineのappendlog lifecycle runnerが定期実行
HETEROLOG_ASYNC_LOG_FILE_LIFECYCLE_MODE=inline
# async fileも同じ共通空き容量閾値を使います。通常fileとは別に方針を指定できます。
HETEROLOG_ASYNC_LOG_FILE_OVERLOAD_POLICY=drop
HETEROLOG_ASYNC_LOG_FILE_SECONDARY_DESTINATION=stdout
# appendlog lifecycle runnerのlevel別internal log委譲先。bare backend名を指定する。
# purge失敗はWARNへ格下げせずERRORへ委譲する。
HETEROLOG_ASYNC_LOG_FILE_LIFECYCLE_ERROR_HANDLER=
HETEROLOG_ASYNC_LOG_FILE_LIFECYCLE_WARN_HANDLER=
HETEROLOG_ASYNC_LOG_FILE_LIFECYCLE_INFO_HANDLER=
HETEROLOG_ASYNC_LOG_FILE_LIFECYCLE_DEBUG_HANDLER=
# async logger内で発生する全internal log共通の保存先identity上書き。
# 実際の委譲先は各*_HANDLERで選び、ここへの値の指定だけではbackendを起動しない。
# 空文字の設定項目とtimeout、retry、認証は通常backend設定を継承する。
# Slackの共通channelだけ指定しても、通常backendのレベル別channelは引き継ぐ。
# Loki labelsは未設定/nullなら継承、{}なら追加labelを消去し、指定mapは全置換する。
# appName/loglevel/envはlogger生成値を維持。不正なlabel名は使用する保存先の起動時検証でエラーにする。
HETEROLOG_ASYNC_LOG_INTERNAL_LOG_FILE_LOG_PATH=
HETEROLOG_ASYNC_LOG_INTERNAL_LOG_FILE_TARGET=
HETEROLOG_ASYNC_LOG_INTERNAL_LOG_FILE_LOG_DIR=
HETEROLOG_ASYNC_LOG_INTERNAL_LOG_FILE_ERROR_LOG_DIR=
# 空なら通常のHETEROLOG_ENABLE_ASYNC_LOG_FILE_SEPARATE_DEBUG_LOG_DIRを継承し、true/falseなら上書きします。
# falseならDEBUG保存先の値を無視してinternal logのHETEROLOG_LOG_DIRを使用します。
HETEROLOG_ASYNC_LOG_INTERNAL_LOG_FILE_SEPARATE_DEBUG_LOG_DIR=
# 分離がtrueのときだけ使用します。空なら通常のHETEROLOG_ASYNC_DEBUG_LOG_DIRを継承し、継承後も空白だけならエラーです。
# このpathの有無ではdirectory分離を切り替えません。DEBUGファイル名の分離設定は通常backendを継承します。
# 継承・上書き後のinternal logでも、defaultとは別の保存先をERROR/DEBUGだけで共有する設定は拒否します。
HETEROLOG_ASYNC_LOG_INTERNAL_LOG_FILE_DEBUG_LOG_DIR=
HETEROLOG_ASYNC_LOG_INTERNAL_LOG_SLACK_CHANNEL=
HETEROLOG_ASYNC_LOG_INTERNAL_LOG_SLACK_ERROR_CHANNEL=
HETEROLOG_ASYNC_LOG_INTERNAL_LOG_SLACK_WARN_CHANNEL=
HETEROLOG_ASYNC_LOG_INTERNAL_LOG_SLACK_INFO_CHANNEL=
HETEROLOG_ASYNC_LOG_INTERNAL_LOG_SLACK_DEBUG_CHANNEL=
HETEROLOG_ASYNC_LOG_INTERNAL_LOG_OPENSEARCH_INDEX=
HETEROLOG_ASYNC_LOG_INTERNAL_LOG_LOKI_LABELS=
HETEROLOG_ASYNC_LOG_INTERNAL_LOG_CLOUDWATCH_LOG_GROUP_NAME=
HETEROLOG_ASYNC_LOG_INTERNAL_LOG_CLOUDWATCH_LOG_STREAM_NAME=
HETEROLOG_ASYNC_LOG_INTERNAL_LOG_CLICKHOUSE_DATABASE=
HETEROLOG_ASYNC_LOG_INTERNAL_LOG_CLICKHOUSE_TABLE=

#同期ログローテーション有効化設定
HETEROLOG_ENABLE_DELIVERY_LOG_FILE_ROTATE=true
# 送達確認ログ保持最大世代数
HETEROLOG_MAX_DELIVERY_LOG_FILE_BACKUPS=60
# 送達確認ログファイル最大保持日数
HETEROLOG_MAX_DELIVERY_LOG_FILE_AGE=60
# 送達確認ログディレクトリ 合計ファイル最大サイズ(MB)
HETEROLOG_MAX_DELIVERY_LOG_FILE_DIR_SIZE_MB=2048
# 送達確認error/debugログの保持上限。未設定または空欄は各項目の共通設定を継承します。
# 明示した0・負数は継承に置き換えず、通常の型・値の検証対象になります。
# 使用する値は世代数2以上、日数1以上、容量10MiB以上かつ最大ログファイルサイズ以上が必要です。
# lifecycle無効・該当ログ分離無効なら値の範囲検証は省略しますが、数値の書式は検証します。
# 世代数・日数は保持の上限であり、容量制限によりそれ以前に削除される場合があります。
# errorログの最大保持世代数。未設定・空欄はHETEROLOG_MAX_DELIVERY_LOG_FILE_BACKUPSを継承。
HETEROLOG_MAX_DELIVERY_ERROR_LOG_FILE_BACKUPS=
# errorログの最大保持日数。未設定・空欄はHETEROLOG_MAX_DELIVERY_LOG_FILE_AGEを継承。
HETEROLOG_MAX_DELIVERY_ERROR_LOG_FILE_AGE=
# errorログのディレクトリ容量上限(MB)。未設定・空欄はHETEROLOG_MAX_DELIVERY_LOG_FILE_DIR_SIZE_MBを継承。
# 通常ログと同じディレクトリの場合、この専用容量は使わず共通容量でディレクトリ全体を制限します。
HETEROLOG_MAX_DELIVERY_ERROR_LOG_FILE_DIR_SIZE_MB=
# debugログの最大保持世代数。未設定・空欄はHETEROLOG_MAX_DELIVERY_LOG_FILE_BACKUPSを継承。
HETEROLOG_MAX_DELIVERY_DEBUG_LOG_FILE_BACKUPS=
# debugログの最大保持日数。未設定・空欄はHETEROLOG_MAX_DELIVERY_LOG_FILE_AGEを継承。
HETEROLOG_MAX_DELIVERY_DEBUG_LOG_FILE_AGE=
# debugログのディレクトリ容量上限(MB)。未設定・空欄はHETEROLOG_MAX_DELIVERY_LOG_FILE_DIR_SIZE_MBを継承。
# 通常ログと同じディレクトリの場合、この専用容量は使わず共通容量でディレクトリ全体を制限します。
HETEROLOG_MAX_DELIVERY_DEBUG_LOG_FILE_DIR_SIZE_MB=
# 送達確認ログローテート済みファイルを圧縮
HETEROLOG_ENABLE_DELIVERY_LOG_FILE_COMPRESS=true
# 送達確認ログ圧縮形式 gzip or zstd or lz4 or xz
HETEROLOG_DELIVERY_LOG_COMPRESS_FORMAT=gzip
# ローテーション済み送達確認ログの圧縮・アーカイブアップロード・パージをどこで実行するか
# delivery loggerはinline lifecycleを持たないため、disableまたはrunnerだけを指定する
# disable=実行しない, runner=専用goroutineのappendlog lifecycle runnerが定期実行
HETEROLOG_DELIVERY_LOG_FILE_LIFECYCLE_MODE=runner
# appendlog lifecycle runnerのlevel別internal log委譲先。bare backend名を指定する。
# purge失敗はWARNへ格下げせずERRORへ委譲する。
HETEROLOG_DELIVERY_LOG_FILE_LIFECYCLE_ERROR_HANDLER=
HETEROLOG_DELIVERY_LOG_FILE_LIFECYCLE_WARN_HANDLER=
HETEROLOG_DELIVERY_LOG_FILE_LIFECYCLE_INFO_HANDLER=
HETEROLOG_DELIVERY_LOG_FILE_LIFECYCLE_DEBUG_HANDLER=
# delivery logger内で発生する全internal log共通の保存先identity上書き。
# 実際の委譲先は各*_HANDLERで選び、ここへの値の指定だけではbackendを起動しない。
# 空文字の設定項目とtimeout、retry、認証は通常backend設定を継承する。
# Slackの共通channelだけ指定しても、通常backendのレベル別channelは引き継ぐ。
# Loki labelsは未設定/nullなら継承、{}なら追加labelを消去し、指定mapは全置換する。
# appName/loglevel/envはlogger生成値を維持。不正なlabel名は使用する保存先の起動時検証でエラーにする。
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_FILE_LOG_PATH=
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_FILE_TARGET=
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_FILE_LOG_DIR=
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_FILE_ERROR_LOG_DIR=
# 空なら通常のHETEROLOG_ENABLE_DELIVERY_LOG_FILE_SEPARATE_DEBUG_LOG_DIRを継承し、true/falseなら上書きします。
# falseならDEBUG保存先の値を無視してinternal logのHETEROLOG_LOG_DIRを使用します。
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_FILE_SEPARATE_DEBUG_LOG_DIR=
# 分離がtrueのときだけ使用します。空なら通常のHETEROLOG_DELIVERY_DEBUG_LOG_DIRを継承し、継承後も空白だけならエラーです。
# このpathの有無ではdirectory分離を切り替えません。DEBUGファイル名の分離設定は通常backendを継承します。
# 継承・上書き後のinternal logでも、defaultとは別の保存先をERROR/DEBUGだけで共有する設定は拒否します。
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_FILE_DEBUG_LOG_DIR=
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_SLACK_CHANNEL=
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_SLACK_ERROR_CHANNEL=
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_SLACK_WARN_CHANNEL=
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_SLACK_INFO_CHANNEL=
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_SLACK_DEBUG_CHANNEL=
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_OPENSEARCH_INDEX=
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_LOKI_LABELS=
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_CLOUDWATCH_LOG_GROUP_NAME=
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_CLOUDWATCH_LOG_STREAM_NAME=
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_CLICKHOUSE_DATABASE=
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_CLICKHOUSE_TABLE=
# Delivery本体の一件送信とは独立したinternal-log fallback専用enqueue/batch設定。
# 実際にhandler targetとして使用するbackendの値だけを読み込む。
# fallback queueの上限は送信開始条件とは別に指定する。worker送信中に上限へ達した場合は
# 古いentryを破棄して新しいentryを残し、送信に失敗したbatchは再投入しない。
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_OPENSEARCH_FLUSH_INTERVAL_SECOND=5
HETEROLOG_MAX_DELIVERY_LOG_INTERNAL_LOG_OPENSEARCH_BULK_DOCUMENTS=500
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_OPENSEARCH_BUFFER_FLUSH_BYTES=5242880
HETEROLOG_MAX_DELIVERY_LOG_INTERNAL_LOG_OPENSEARCH_BULK_REQUEST_BYTES=15728640
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_LOKI_FLUSH_INTERVAL_SECOND=5
HETEROLOG_MAX_DELIVERY_LOG_INTERNAL_LOG_LOKI_PUSH_ENTRIES=500
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_LOKI_BUFFER_FLUSH_BYTES=1048576
HETEROLOG_MAX_DELIVERY_LOG_INTERNAL_LOG_LOKI_FALLBACK_QUEUE_ENTRIES=1000
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_CLOUDWATCH_FLUSH_INTERVAL_SECOND=5
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_CLOUDWATCH_BUFFER_FLUSH_MAX_EVENTS=500
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_CLOUDWATCH_BUFFER_FLUSH_BYTES=524288
HETEROLOG_MAX_DELIVERY_LOG_INTERNAL_LOG_CLOUDWATCH_FALLBACK_QUEUE_EVENTS=1000
HETEROLOG_DELIVERY_LOG_INTERNAL_LOG_SLACK_INTERVALS=1,5,30,60,120,240
HETEROLOG_MAX_DELIVERY_LOG_INTERNAL_LOG_SLACK_LOGS_PER_NOTIFICATION=10
HETEROLOG_MAX_DELIVERY_LOG_INTERNAL_LOG_SLACK_REST_THRESHOLD_MINUTE=360

# sync、async、deliveryの通常/error/debug file loggerとbackend failure archive共通設定
# inline・runner共通。true（既定）は宛先登録済みログ系列のcheckpoint欠落を空の完了記録から復旧する
# 宛先追加前の残存ログも含めて再uploadを許可する。falseは欠落時に起動失敗とする
# 初回作成は許可する。破損JSON・権限エラー・宛先登録manifestの異常は自動復旧しない
HETEROLOG_ENABLE_ARCHIVE_CHECKPOINT_AUTO_RECOVERY=true

# sync、async、delivery file loggerとfailure archiveのappendlog lifecycle runner共通設定
HETEROLOG_APPENDLOG_RUNNER_INTERVAL_SECOND=900
# trueはSupervisorも有効にし、lifecycle失敗後にRunnerを終了・再起動する場合だけ指定する
HETEROLOG_ENABLE_APPENDLOG_RUNNER_STOP_ON_ERROR=false
# trueの場合、appendlog Runnerのerror終了とpanicをdelay付きで再起動する
HETEROLOG_ENABLE_APPENDLOG_RUNNER_SUPERVISOR=false
# Supervisor有効時の再起動待機時間（ミリ秒、1以上）
HETEROLOG_APPENDLOG_RUNNER_SUPERVISOR_RESTART_DELAY_MILLISECOND=1000
# Supervisor有効時の最大再起動回数（1以上）
HETEROLOG_MAX_APPENDLOG_RUNNER_SUPERVISOR_RESTARTS=3

# ローテーション済み appendlog ファイルのオブジェクトストレージアップロード
# 宛先を追加する前から存在したログは、その宛先へ送信せず、upload完了を理由に削除もしない（通常の保持設定に従って削除）
HETEROLOG_ENABLE_LOG_FILE_OBJECT_STORAGE_UPLOAD=false
# 全体スイッチが true のときにアップロードする分類
HETEROLOG_ENABLE_LOG_FILE_DEFAULT_OBJECT_STORAGE_UPLOAD=true
HETEROLOG_ENABLE_LOG_FILE_ERROR_OBJECT_STORAGE_UPLOAD=true
HETEROLOG_ENABLE_LOG_FILE_DEBUG_OBJECT_STORAGE_UPLOAD=true
HETEROLOG_LOG_FILE_OBJECT_STORAGE_UPLOAD_TYPE=s3
HETEROLOG_ENABLE_ASYNC_LOG_FILE_OBJECT_STORAGE_UPLOAD=false
# 全体スイッチが true のときにアップロードする分類
HETEROLOG_ENABLE_ASYNC_LOG_FILE_DEFAULT_OBJECT_STORAGE_UPLOAD=true
HETEROLOG_ENABLE_ASYNC_LOG_FILE_ERROR_OBJECT_STORAGE_UPLOAD=true
HETEROLOG_ENABLE_ASYNC_LOG_FILE_DEBUG_OBJECT_STORAGE_UPLOAD=true
HETEROLOG_ASYNC_LOG_FILE_OBJECT_STORAGE_UPLOAD_TYPE=s3
HETEROLOG_ENABLE_DELIVERY_LOG_FILE_OBJECT_STORAGE_UPLOAD=false
# 全体スイッチが true のときにアップロードする分類
HETEROLOG_ENABLE_DELIVERY_LOG_FILE_DEFAULT_OBJECT_STORAGE_UPLOAD=true
HETEROLOG_ENABLE_DELIVERY_LOG_FILE_ERROR_OBJECT_STORAGE_UPLOAD=true
HETEROLOG_ENABLE_DELIVERY_LOG_FILE_DEBUG_OBJECT_STORAGE_UPLOAD=true
HETEROLOG_DELIVERY_LOG_FILE_OBJECT_STORAGE_UPLOAD_TYPE=s3
HETEROLOG_OBJECT_STORAGE_S3_REGION=ap-northeast-1
# 空ならリージョンの標準エンドポイント。クエリとフラグメントは指定不可
HETEROLOG_OBJECT_STORAGE_S3_ENDPOINT=
HETEROLOG_OBJECT_STORAGE_S3_ACCESS_KEY_ID=
HETEROLOG_OBJECT_STORAGE_S3_SECRET_ACCESS_KEY=
HETEROLOG_OBJECT_STORAGE_S3_SESSION_TOKEN=
HETEROLOG_OBJECT_STORAGE_S3_TIMEOUT_SECOND=60
HETEROLOG_ENABLE_OBJECT_STORAGE_S3_FORCE_PATH_STYLE=false
# S3 clientは用途にかかわらず、各uploadにつきPUTを一回だけ行う。
# 失敗後の保持・再送は各呼び出し経路が管理する。圧縮log fileはspool選択時だけ再送する。
HETEROLOG_LOG_FILE_OBJECT_STORAGE_S3_BUCKET=
HETEROLOG_LOG_FILE_OBJECT_STORAGE_S3_PREFIX=
HETEROLOG_LOG_FILE_ERROR_OBJECT_STORAGE_S3_BUCKET=
HETEROLOG_LOG_FILE_ERROR_OBJECT_STORAGE_S3_PREFIX=
