HETEROLOG_CLOUD_PROVIDER_REGION=""
# ecs / ec2 / k8s / docker / local etc...
HETEROLOG_RUNTIME_TYPE="local"
# task id / pod name / instance id / hostname etc...
HETEROLOG_INSTANCE_ID=""
# S3複数宛先（JSON配列）。空欄なら従来の一件指定を使用します。指定時は一件指定へ追加せず置換します。
# 例: HETEROLOG_LOG_FILE_OBJECT_STORAGE_S3_DESTINATIONS='[{"bucket":"logs-primary"},{"bucket":"logs-backup","region":"us-east-1"}]'
# 各要素: bucket, prefix, region, endpoint, access_key_id, secret_access_key, session_token, force_path_style, timeout_seconds
# 省略した項目は一件指定の設定（認証などはHETEROLOG_OBJECT_STORAGE_S3_*）を引き継ぎます。明示した空文字・false・0は優先します。
# timeout_secondsは非負整数（0はclient既定値）。重複した実保存先、空配列、不正なJSONは起動時に拒否します。
# 通常ログのERROR/DEBUGの一覧が空欄なら、同じloggerの通常ログ用JSONを使います。JSONの項目は各roleの設定より優先します。
# 一覧の宛先数によらず *_OBJECT_STORAGE_UPLOAD_TYPE=s3 を指定します。各 *_UPLOAD の有効化も必要です。
# Failure archiveの一覧はbackend・loggerごとの独立設定です。通常ログの一覧は引き継ぎません。
# 認証情報を含む値は公開・コミットしないでください。
HETEROLOG_LOG_FILE_OBJECT_STORAGE_S3_DESTINATIONS=
HETEROLOG_LOG_FILE_ERROR_OBJECT_STORAGE_S3_DESTINATIONS=
HETEROLOG_LOG_FILE_DEBUG_OBJECT_STORAGE_S3_DESTINATIONS=
HETEROLOG_ASYNC_LOG_FILE_OBJECT_STORAGE_S3_DESTINATIONS=
HETEROLOG_ASYNC_LOG_FILE_ERROR_OBJECT_STORAGE_S3_DESTINATIONS=
HETEROLOG_ASYNC_LOG_FILE_DEBUG_OBJECT_STORAGE_S3_DESTINATIONS=
HETEROLOG_DELIVERY_LOG_FILE_OBJECT_STORAGE_S3_DESTINATIONS=
HETEROLOG_DELIVERY_LOG_FILE_ERROR_OBJECT_STORAGE_S3_DESTINATIONS=
HETEROLOG_DELIVERY_LOG_FILE_DEBUG_OBJECT_STORAGE_S3_DESTINATIONS=
HETEROLOG_OPENSEARCH_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_S3_DESTINATIONS=
HETEROLOG_ASYNC_OPENSEARCH_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_S3_DESTINATIONS=
HETEROLOG_DELIVERY_OPENSEARCH_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_S3_DESTINATIONS=
HETEROLOG_LOKI_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_S3_DESTINATIONS=
HETEROLOG_ASYNC_LOKI_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_S3_DESTINATIONS=
HETEROLOG_DELIVERY_LOKI_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_S3_DESTINATIONS=
HETEROLOG_CLOUDWATCH_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_S3_DESTINATIONS=
HETEROLOG_ASYNC_CLOUDWATCH_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_S3_DESTINATIONS=
HETEROLOG_DELIVERY_CLOUDWATCH_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_S3_DESTINATIONS=
HETEROLOG_CLICKHOUSE_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_S3_DESTINATIONS=
HETEROLOG_ASYNC_CLICKHOUSE_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_S3_DESTINATIONS=
HETEROLOG_DELIVERY_CLICKHOUSE_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_S3_DESTINATIONS=

# 管理用API: 稼働中に出力先のログレベルとsamplingを変更するHTTP APIです。
# アプリケーションがEnvConfig.AdminServerConfigとStartAdminServerで起動し、
# EnvConfig.NewAdminAuditが作る監査用loggerを渡します。
# 待ち受けるアドレス（例: 127.0.0.1:9100）。空なら起動しません。
# ホストを省略した場合（例: :9100）は127.0.0.1だけで待ち受けます。
HETEROLOG_ADMIN_ADDR=
# 要求に必要なトークン（32文字以上）。要求はAuthorization: Bearer <トークン>で送ります。
# 例えば openssl rand -hex 32 で作ります。秘密情報のため、エラーや記録には表示しません。
HETEROLOG_ADMIN_TOKEN=
# HTTPSで待ち受ける場合の証明書と秘密鍵のファイル（PEM）。両方を指定します。
# 127.0.0.1以外で待ち受ける場合は必須です。
HETEROLOG_ADMIN_TLS_CERT_FILE=
HETEROLOG_ADMIN_TLS_KEY_FILE=

# 管理用APIの監査log: 変更の要求、変更を始める時点の設定、変更後の設定と、拒否した要求を
# 送達確認loggerで記録します。HETEROLOG_ADMIN_ADDRを設定した場合だけ使います。
# 接続先・認証・timeoutなどはHETEROLOG_DELIVERY_*の設定を引き継ぎます
# （HETEROLOG_ENABLE_DELIVERY_LOGGING=falseでも同じです）。
# 監査logの出力先。設定可能値 'file', 'stdout', 'slack', 'opensearch', 'loki', 'cloudwatchlogs', 'clickhouse'
# 監査logは欠けてはいけないため、未設定時はほかのloggerと違い、stdoutとfileの両方です。
# ERRORの記録（要求どおりにならなかった変更、記録が届かなかったこと）は、ERRORだけを
# 受け取るSlack（HETEROLOG_DELIVERY_SLACK_LOG_LEVELの既定）を加えると通知になります。
HETEROLOG_ADMIN_AUDIT_LOG_TYPE=stdout,file
# 監査logのfileを置くdirectory（HETEROLOG_SYSTEM_LOG_DIRとHETEROLOG_TARGETを基準に解決）。
# 一つの要求の記録が分かれないよう、ERRORとDEBUGもこのdirectoryの同じfileへ書き、
# 保守で消さず、圧縮・uploadもしません。ほかの保存先と同じdirectoryは使えません。
HETEROLOG_ADMIN_AUDIT_FILE_LOG_DIR=/audit_logs
# 出力先ごとの監査logの記録先。空の項目はHETEROLOG_DELIVERY_*の設定を引き継ぎます。
# 通常のlogと分けるには、監査用のchannel・index・label・group・tableを指定します。
HETEROLOG_ADMIN_AUDIT_SLACK_CHANNEL=
HETEROLOG_ADMIN_AUDIT_OPENSEARCH_INDEX=
# Lokiのlabel（JSONのobject）。未設定なら追加labelなしです。
HETEROLOG_ADMIN_AUDIT_LOKI_LABELS=
HETEROLOG_ADMIN_AUDIT_CLOUDWATCH_LOG_GROUP_NAME=
HETEROLOG_ADMIN_AUDIT_CLOUDWATCH_LOG_STREAM_NAME=
HETEROLOG_ADMIN_AUDIT_CLICKHOUSE_DATABASE=
HETEROLOG_ADMIN_AUDIT_CLICKHOUSE_TABLE=

# trace: EnvConfig.NewTelemetryが作るTelemetryのTracerが記録したspanと、otelexportで
# 渡したOpenTelemetry SDKのspanを送ります。loggerの処理も記録するには、Tracerを
# WithObserversでloggerへ渡します。Resource（service.nameなど）は、HETEROLOG_APP_NAME・
# HETEROLOG_APP_ENVなど、loggerと同じ項目から作ります。
# traceを有効にするか。falseなら、ほかのHETEROLOG_TRACES_*は読まず、Tracerは何も記録しません。
HETEROLOG_ENABLE_TRACES=false
# spanの送り先。設定可能値 'otlp', 'file', 'stdout'（カンマ区切りで複数）。
# 送り先ごとに待ち行列を持つため、遅い送り先はほかの送り先を待たせません。
HETEROLOG_TRACES_TYPE=otlp
# 新しく始めるtraceを記録する割合（0から1）。親のspanが分かるspanは、親の判定に従います。
HETEROLOG_TRACES_SAMPLING_RATIO=1
# 送り先ごとに、送るのを待つspanの数の上限。一杯の間に終わったspanは捨て、
# heterolog_trace_spans_total（outcome=dropped）で数えます。
HETEROLOG_TRACES_QUEUE_SIZE=2048
# 一度に送るspanの数の上限（HETEROLOG_TRACES_QUEUE_SIZE以下）。
HETEROLOG_TRACES_BATCH_SIZE=512
# spanがbatchの一杯になるのを待つ最長の時間（ミリ秒）。
HETEROLOG_TRACES_EXPORT_INTERVAL_MILLISECOND=5000
# OTLP/HTTPの受信先のURL（protobufで送ります）。/v1/tracesは自動では足しません。redirectは追いません。
HETEROLOG_TRACES_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# 要求に足すheader（JSONのobject、例: {"Authorization":"Bearer <token>"}）。
# 認証情報を含み得るため、エラーには表示しません。
HETEROLOG_TRACES_OTLP_HEADERS=
# 要求の本文の圧縮。設定可能値 'gzip', 'none'
HETEROLOG_TRACES_OTLP_COMPRESSION=gzip
# 1回の要求のtimeout（秒）。
HETEROLOG_TRACES_OTLP_TIMEOUT_SECOND=10
# 一時的な失敗の後に送り直す回数。0なら送り直しません。OTLPの仕様に従い、送り直すのは
# 429・502・503・504と、応答を受け取れなかった失敗（接続の拒否、切断、timeout）だけです。
# 送り直しても送れなかったspanは、下のfailure storeへ渡します。failure storeがなければ捨て、
# heterolog_trace_spans_total（outcome=failure）で数えます。
HETEROLOG_TRACES_OTLP_RETRIES=3
# 送り直す前に待つ時間は、基準（ミリ秒）から1回ごとに2倍にして上限（ミリ秒）までに抑え、
# その半分から全部までの間で無作為に選びます。応答のRetry-Afterがあればそれに従い、上限より
# 長ければ送り直しません。
HETEROLOG_TRACES_OTLP_RETRY_BASE_DELAY_MILLISECOND=1000
HETEROLOG_TRACES_OTLP_RETRY_MAX_DELAY_MILLISECOND=5000
# 一時的な失敗が続いたら、ログの出力先と同じcircuit breakerで、しばらく送るのを止めます。
# 15秒以内の間隔で3回以上続いた失敗が1分続くと30秒止め、その後1件だけ送って回復を確かめます。
HETEROLOG_ENABLE_TRACES_OTLP_CIRCUIT_BREAKER=false
# otlpの送り先へ送れなかったspanの失敗処理。ログの出力先（Lokiなど）と同じkeyの並びで、同じ意味です。
# spanは1件ずつ、ResourceとScopeを含むOTLP/JSONのrecordにして保存します。送り直しを許す失敗
# （結果の分からない失敗を含む）のspanはspoolから送り直し、受信側が拒否したspanはdead、
# 一部だけ受け付けられたspanはquarantineとして、送り直さずに残します。
# 内部ログの通知先（*_HANDLER）はなく、WithTelemetryErrorHandlerの関数（既定は標準のlogger）へ渡します。
# failure archiveのobject storageへのuploadは、ログの出力先と同じです。uploadできなかった圧縮fileの
# spoolとarchiveは、ログと共通のHETEROLOG_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_*の設定で、
# loggerとは別の保存先（loggerの契約の位置にtelemetry）を使います。
# DURABLE_TYPES=noneの場合だけ、overload判定を行わずDEGRADE_TYPESへ直接退避する
HETEROLOG_ENABLE_TRACES_OTLP_DEGRADE=true
HETEROLOG_MAX_TRACES_OTLP_FAILURE_HANDLER_CONCURRENT=8
HETEROLOG_TRACES_OTLP_DURABLE_TYPES=spool,fileArchive
# DEGRADE_TYPESはstdoutのみ実装済み。s3,nfsは予約値で、指定すると起動時エラーになります。
HETEROLOG_TRACES_OTLP_DEGRADE_TYPES=stdout
HETEROLOG_MAX_TRACES_OTLP_DURABLE_FILE_ARCHIVE_SIZE_MB=50
# disable=compress/purgeを実行しない（保存・rotationは継続）, inline=failure handlerで実行, runner=専用runnerで周期実行
HETEROLOG_TRACES_OTLP_DURABLE_FILE_ARCHIVE_LIFECYCLE_MODE=inline
HETEROLOG_TRACES_OTLP_FAILURE_ARCHIVE_DIR="traces_otlp_failure_archives"
HETEROLOG_TRACES_OTLP_FAILURE_SPOOL_DIR="traces_otlp"
HETEROLOG_TRACES_OTLP_ENABLE_DURABLE_FILE_ARCHIVE_ROTATE=true
# 保持世代数・保持日数・ディレクトリ上限(MB)。0は上限なしで、その条件では削除しません（既定）。
HETEROLOG_MAX_TRACES_OTLP_ENABLE_DURABLE_FILE_ARCHIVE_BACKUPS=0
HETEROLOG_MAX_TRACES_OTLP_ENABLE_DURABLE_FILE_ARCHIVE_AGE=0
HETEROLOG_MAX_TRACES_OTLP_ENABLE_DURABLE_FILE_ARCHIVE_DIR_SIZE_MB=0
HETEROLOG_ENABLE_TRACES_OTLP_DURABLE_FILE_ARCHIVE_COMPRESS=true
HETEROLOG_TRACES_OTLP_DURABLE_FILE_ARCHIVE_COMPRESS_FORMAT=zstd
HETEROLOG_TRACES_OTLP_DURABLE_FILE_ARCHIVE_ROTATION=daily
HETEROLOG_ENABLE_TRACES_OTLP_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_UPLOAD=false
HETEROLOG_TRACES_OTLP_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_UPLOAD_TYPE=s3
HETEROLOG_TRACES_OTLP_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_S3_BUCKET=
HETEROLOG_TRACES_OTLP_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_S3_PREFIX=traces/otlp/failure-archive
# S3複数宛先（JSON配列）。書き方はHETEROLOG_LOG_FILE_OBJECT_STORAGE_S3_DESTINATIONSと同じです。
HETEROLOG_TRACES_OTLP_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_S3_DESTINATIONS=
HETEROLOG_TRACES_OTLP_DURABLE_FILE_ARCHIVE_OVERLOAD_POLICY=drop
HETEROLOG_TRACES_OTLP_DURABLE_FILE_ARCHIVE_SECONDARY_DESTINATION=stdout
HETEROLOG_TRACES_OTLP_SPOOL_OVERLOAD_POLICY=drop
HETEROLOG_TRACES_OTLP_SPOOL_SECONDARY_DESTINATION=stdout
HETEROLOG_MAX_TRACES_OTLP_SPOOL_FILE_ACTIVE_DIR_SIZE_MB=1024
# active spoolの最古データがこの日数より古い場合に警告する（保存は拒否しない。0で無効）
HETEROLOG_TRACES_OTLP_ACTIVE_SPOOL_BACKLOG_WARN_AFTER_DAYS=120
HETEROLOG_MAX_TRACES_OTLP_SPOOL_SCANNED_CACHE_USAGE_COUNT=100000
HETEROLOG_TRACES_OTLP_SPOOL_CACHE_LIFETIME_SECOND=30
HETEROLOG_USE_MEMORY_PRESSURE_TRACES_OTLP_SPOOL_OVERLOAD=false
# spoolから送り直すrunnerの設定。ログの出力先の*_SPOOL_RUNNER_*と同じです。
# 再起動の上限は、ログと共通のHETEROLOG_MAX_RESTART_SPOOL_TIMESを使います。
HETEROLOG_TRACES_OTLP_SPOOL_RUNNER_INTERVAL_MILLISECOND=100
HETEROLOG_ENABLE_TRACES_OTLP_SPOOL_RUNNER_STOP_ON_ERROR=false
HETEROLOG_ENABLE_PURGE_TRACES_OTLP_SPOOL_DONE=true
HETEROLOG_MAX_TRACES_OTLP_SPOOL_DONE_AGE=30
HETEROLOG_MAX_TRACES_OTLP_SPOOL_DONE_DIR_SIZE_MB=2048
HETEROLOG_ENABLE_PURGE_TRACES_OTLP_SPOOL_DEAD=false
HETEROLOG_MAX_TRACES_OTLP_SPOOL_DEAD_AGE=30
HETEROLOG_MAX_TRACES_OTLP_SPOOL_DEAD_DIR_SIZE_MB=2048
HETEROLOG_ENABLE_PURGE_TRACES_OTLP_SPOOL_QUARANTINE=false
HETEROLOG_MAX_TRACES_OTLP_SPOOL_QUARANTINE_AGE=30
HETEROLOG_MAX_TRACES_OTLP_SPOOL_QUARANTINE_DIR_SIZE_MB=2048
HETEROLOG_TRACES_OTLP_SPOOL_RUNNER_PURGE_INTERVAL_SECOND=60
HETEROLOG_ENABLE_TRACES_OTLP_SPOOL_SIZE_ESTIMATE_CACHE=true
HETEROLOG_TRACES_OTLP_SPOOL_DIR_FULL_SCAN_EVERY_N_CHECKS=65536
HETEROLOG_MAX_TRACES_OTLP_SPOOL_FULL_SCAN_INTERVAL_SECOND=300
HETEROLOG_TRACES_OTLP_SPOOL_RUNNER_RETRY_FINALIZE_DELAY_MILLISECOND=1000
HETEROLOG_MAX_TRACES_OTLP_SPOOL_FINALIZE_FAILURE_ENTRIES=4098
# 送信先がRetry-Afterで指定した再送待機の上限（秒）。より長い指定はこの時間に短縮して警告を通知します。
# 通常送信で受け取った指定と、spoolに保存済みの待機にも適用します。正の値が必須です。
HETEROLOG_TRACES_OTLP_SPOOL_RUNNER_MAX_RETRY_AFTER_SECOND=3600
# spanのfile（spans.jsonl）を置くdirectory（HETEROLOG_SYSTEM_LOG_DIRとHETEROLOG_TARGETを基準に解決）。
# 送るたびに、そのbatchをOTLP/JSONの1行として追記します。fileはrotationしません。
HETEROLOG_TRACES_FILE_DIR=/traces
