# OpenSearch情報Async
HETEROLOG_ASYNC_OPENSEARCH_ENDPOINT="https://localhost:9200"
HETEROLOG_ASYNC_OPENSEARCH_USERNAME=
HETEROLOG_ASYNC_OPENSEARCH_PASSWORD=
HETEROLOG_ASYNC_OPENSEARCH_INDEX="app-log-heterolog"
HETEROLOG_ASYNC_OPENSEARCH_SKIP_VERIFY_SSL=true
# 送達確認ロガー OpenSearch。接続先・認証・SSL設定はsync/asyncから継承しません。
# 同じ接続先を使う場合も、HETEROLOG_DELIVERY_*へ明示的に同じ値を設定します。
HETEROLOG_DELIVERY_OPENSEARCH_ENDPOINT="https://localhost:9200"
HETEROLOG_DELIVERY_OPENSEARCH_USERNAME=
HETEROLOG_DELIVERY_OPENSEARCH_PASSWORD=
HETEROLOG_DELIVERY_OPENSEARCH_SKIP_VERIFY_SSL=true
# 送達確認ロガー OpenSearch flush先index
HETEROLOG_DELIVERY_OPENSEARCH_INDEX="app-log-heterolog-delivery"
# 秒単位。未設定時も1秒です。
HETEROLOG_ASYNC_OPENSEARCH_TIMEOUT_SECOND=1
HETEROLOG_DELIVERY_OPENSEARCH_TIMEOUT_SECOND=1
# 秒単位
HETEROLOG_ASYNC_OPENSEARCH_FLUSH_INTERVALS=5
HETEROLOG_ASYNC_MAX_BULK_DOCUMENT_OPENSEARCH_FLUSH=500
HETEROLOG_ASYNC_OPENSEARCH_BUFFER_FLUSH_BYTES=5242880
# 1回のBulk requestへまとめる圧縮前NDJSONの上限（バイト）。超過分は別requestへ分割します。
HETEROLOG_MAX_ASYNC_OPENSEARCH_BULK_REQUEST_BYTES=15728640

# opensearch otelフォーマット準拠
HETEROLOG_ENABLE_OPENSEARCH_OTEL_FORMAT_LOG=true
HETEROLOG_ENABLE_ASYNC_OPENSEARCH_OTEL_FORMAT_LOG=true
HETEROLOG_ENABLE_DELIVERY_OPENSEARCH_OTEL_FORMAT_LOG=true

# 標準出力のログをotel準拠のjson形式にする
HETEROLOG_ENABLE_STDOUT_OTEL_FORMAT=false

#送信時にデータを圧縮する
HETEROLOG_ENABLE_OPENSEARCH_COMPRESS_REQUEST=false
#通信障害などは自動的に再送する
# 直後の *_RETRY_CLIENT_MODE には次のいずれかを指定する（各行の「# -」直後の名前が設定値）:
# - none: raw client。retryもcircuit breakerも適用しない
# - retry: RetryingClient -> raw client。timeout・接続断・一時的なHTTPエラーなど、再試行可能と判定された失敗をMaxAttemptsまで再試行する。待機時間はBaseDelayずつ増やし、MaxDelayを上限とする
# - retry_policy: RetryPolicyClient -> raw client。恒久エラー・親context終了・breaker openは1回、timeout・EOF・接続断・HTTP 408・500・504は最大2回、HTTP 502・503・throttlingはMaxAttemptsまで試行する。429・503のRetry-Afterとcontext残時間も考慮する
# - circuit_breaker: CircuitBreakerClient -> raw client。retryは行わず、連続障害時はcooldown中の接続を抑止する
# - retry_with_breaker: RetryingClient -> CircuitBreakerClient -> raw client。RetryingClientによる各試行をbreakerが監視し、open後は残りの試行を抑止する
# - retry_policy_with_breaker: RetryPolicyClient -> CircuitBreakerClient -> raw client。RetryPolicyClientによる各試行をbreakerが監視し、open後は残りの試行を抑止する
HETEROLOG_OPENSEARCH_RETRY_CLIENT_MODE=retry_policy
# 固定_id createの409は、以前の試行で作成済みとみなし成功へ正規化する
# circuit breakerを含むmodeではopen中の接続をskipし、cooldown後は1件だけprobeとして通す（固定動作）
# 初回の送信に加える再試行の回数。0なら再試行しません（再試行するmodeでは、負の値はエラー）
HETEROLOG_MAX_OPENSEARCH_RETRYABLE_CLIENT_RETRIES=2
#再試行時の基準遅延時間（ミリ秒）
# 再試行の前に待つ時間の基準と上限（ミリ秒）。再試行するmodeでは、0以下はエラー
HETEROLOG_OPENSEARCH_RETRYABLE_CLIENT_MILLISECOND=200
#再試行時の最大遅延時間（ミリ秒）
HETEROLOG_MAX_OPENSEARCH_RETRYABLE_CLIENT_DELAY_MILLISECOND=1000
#送信時にデータを圧縮する
HETEROLOG_ENABLE_ASYNC_OPENSEARCH_COMPRESS_REQUEST=false
#通信障害などは自動的に再送する
# 直後の *_RETRY_CLIENT_MODE には次のいずれかを指定する（各行の「# -」直後の名前が設定値）:
# - none: raw client。retryもcircuit breakerも適用しない
# - retry: RetryingClient -> raw client。timeout・接続断・一時的なHTTPエラーなど、再試行可能と判定された失敗をMaxAttemptsまで再試行する。待機時間はBaseDelayずつ増やし、MaxDelayを上限とする
# - retry_policy: RetryPolicyClient -> raw client。恒久エラー・親context終了・breaker openは1回、timeout・EOF・接続断・HTTP 408・500・504は最大2回、HTTP 502・503・throttlingはMaxAttemptsまで試行する。429・503のRetry-Afterとcontext残時間も考慮する
# - circuit_breaker: CircuitBreakerClient -> raw client。retryは行わず、連続障害時はcooldown中の接続を抑止する
# - retry_with_breaker: RetryingClient -> CircuitBreakerClient -> raw client。RetryingClientによる各試行をbreakerが監視し、open後は残りの試行を抑止する
# - retry_policy_with_breaker: RetryPolicyClient -> CircuitBreakerClient -> raw client。RetryPolicyClientによる各試行をbreakerが監視し、open後は残りの試行を抑止する
HETEROLOG_ASYNC_OPENSEARCH_RETRY_CLIENT_MODE=retry_policy
# 固定_id createの409は、以前の試行で作成済みとみなし成功へ正規化する
# circuit breakerを含むmodeではopen中の接続をskipし、cooldown後は1件だけprobeとして通す（固定動作）
# 初回の送信に加える再試行の回数。0なら再試行しません（再試行するmodeでは、負の値はエラー）
HETEROLOG_MAX_ASYNC_OPENSEARCH_RETRYABLE_CLIENT_RETRIES=2
#再試行時の基準遅延時間（ミリ秒）
# 再試行の前に待つ時間の基準と上限（ミリ秒）。再試行するmodeでは、0以下はエラー
HETEROLOG_ASYNC_OPENSEARCH_RETRYABLE_CLIENT_MILLISECOND=200
#再試行時の最大遅延時間（ミリ秒）
HETEROLOG_MAX_ASYNC_OPENSEARCH_RETRYABLE_CLIENT_DELAY_MILLISECOND=1000
#送達確認ロガー　送信時にデータを圧縮する
HETEROLOG_ENABLE_DELIVERY_OPENSEARCH_COMPRESS_REQUEST=false
#通信障害などは自動的に再送する
# 直後の *_RETRY_CLIENT_MODE には次のいずれかを指定する（各行の「# -」直後の名前が設定値）:
# - none: raw client。retryもcircuit breakerも適用しない
# - retry: RetryingClient -> raw client。timeout・接続断・一時的なHTTPエラーなど、再試行可能と判定された失敗をMaxAttemptsまで再試行する。待機時間はBaseDelayずつ増やし、MaxDelayを上限とする
# - retry_policy: RetryPolicyClient -> raw client。恒久エラー・親context終了・breaker openは1回、timeout・EOF・接続断・HTTP 408・500・504は最大2回、HTTP 502・503・throttlingはMaxAttemptsまで試行する。429・503のRetry-Afterとcontext残時間も考慮する
# - circuit_breaker: CircuitBreakerClient -> raw client。retryは行わず、連続障害時はcooldown中の接続を抑止する
# - retry_with_breaker: RetryingClient -> CircuitBreakerClient -> raw client。RetryingClientによる各試行をbreakerが監視し、open後は残りの試行を抑止する
# - retry_policy_with_breaker: RetryPolicyClient -> CircuitBreakerClient -> raw client。RetryPolicyClientによる各試行をbreakerが監視し、open後は残りの試行を抑止する
HETEROLOG_DELIVERY_OPENSEARCH_RETRY_CLIENT_MODE=retry_policy
# 固定_id createの409は、以前の試行で作成済みとみなし成功へ正規化する
# circuit breakerを含むmodeではopen中の接続をskipし、cooldown後は1件だけprobeとして通す（固定動作）
# 初回の送信に加える再試行の回数。0なら再試行しません（再試行するmodeでは、負の値はエラー）
HETEROLOG_MAX_DELIVERY_OPENSEARCH_RETRYABLE_CLIENT_RETRIES=2
#再試行時の基準遅延時間（ミリ秒）
# 再試行の前に待つ時間の基準と上限（ミリ秒）。再試行するmodeでは、0以下はエラー
HETEROLOG_DELIVERY_OPENSEARCH_RETRYABLE_CLIENT_MILLISECOND=200
#再試行時の最大遅延時間（ミリ秒）
HETEROLOG_MAX_DELIVERY_OPENSEARCH_RETRYABLE_CLIENT_DELAY_MILLISECOND=1000

#spool設定
#最大spool runner再起動回数 0は無制限
HETEROLOG_MAX_RESTART_SPOOL_TIMES=0

# .log.<codec>・backend送信失敗archiveの.jsonl.<codec>のupload失敗時のdurable store（sync/async logger共通）
# fileArchiveとspoolは対等な保存先で、両方を指定した場合は両方への保存完了後に元fileを解放する
HETEROLOG_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_DURABLE_TYPES=fileArchive,spool
# 保存先: <HETEROLOG_APP_STATE_DIR>/<HETEROLOG_TARGET>/compressed_log_file_upload_failures/s3/{logger,async_logger}/<destination_id>/{retryable,permanent}
# 各分類directory直下へ元file名のまま一件ずつ保存する（bundle directory・manifestなし）
# 同名で別内容のfileがある場合は旧fileを.preservedへ保全し、警告を通知する
HETEROLOG_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_ARCHIVE_DIR=compressed_log_file_upload_failures
HETEROLOG_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_ARCHIVE_LIFECYCLE_INTERVAL_SECOND=60
# retryable・permanentはuploadできずに保持しているfailure dataです。未設定時は削除しません。
# trueにすると、保持日数・容量を超えた古いfileから自動削除します。
HETEROLOG_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_ARCHIVE_ENABLE_PURGE_RETRYABLE=false
HETEROLOG_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_ARCHIVE_RETRYABLE_MAX_FILE_AGE_DAYS=365
HETEROLOG_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_ARCHIVE_RETRYABLE_MAX_DIR_SIZE_GB=100
HETEROLOG_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_ARCHIVE_ENABLE_PURGE_PERMANENT=false
HETEROLOG_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_ARCHIVE_PERMANENT_MAX_FILE_AGE_DAYS=365
HETEROLOG_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_ARCHIVE_PERMANENT_MAX_DIR_SIZE_GB=100

# .log.<codec>・backend送信失敗archiveの.jsonl.<codec>のupload失敗時のdurable store（Delivery logger）
HETEROLOG_DELIVERY_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_DURABLE_TYPES=fileArchive,spool
# 保存先: <HETEROLOG_APP_STATE_DIR>/<HETEROLOG_TARGET>/compressed_log_file_upload_failures/s3/delivery_logger/<destination_id>/{retryable,permanent}
# 各分類directory直下へ元file名のまま一件ずつ保存する（bundle directory・manifestなし）
# 同名で別内容のfileがある場合は旧fileを.preservedへ保全し、警告を通知する
HETEROLOG_DELIVERY_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_ARCHIVE_DIR=compressed_log_file_upload_failures
HETEROLOG_DELIVERY_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_ARCHIVE_LIFECYCLE_INTERVAL_SECOND=60
# retryable・permanentはuploadできずに保持しているfailure dataです。未設定時は削除しません。
# trueにすると、保持日数・容量を超えた古いfileから自動削除します。
HETEROLOG_DELIVERY_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_ARCHIVE_ENABLE_PURGE_RETRYABLE=false
HETEROLOG_DELIVERY_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_ARCHIVE_RETRYABLE_MAX_FILE_AGE_DAYS=730
HETEROLOG_DELIVERY_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_ARCHIVE_RETRYABLE_MAX_DIR_SIZE_GB=500
HETEROLOG_DELIVERY_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_ARCHIVE_ENABLE_PURGE_PERMANENT=false
HETEROLOG_DELIVERY_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_ARCHIVE_PERMANENT_MAX_FILE_AGE_DAYS=730
HETEROLOG_DELIVERY_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_ARCHIVE_PERMANENT_MAX_DIR_SIZE_GB=500

# compressed log file upload failure spool（sync/async logger共通設定）
# 保存先: <HETEROLOG_SYSTEM_LIB_DIR>/<HETEROLOG_TARGET>/spool/objectstorage/s3/logger/<destination_id>/{active,...}
#       または <HETEROLOG_SYSTEM_LIB_DIR>/<HETEROLOG_TARGET>/spool/objectstorage/s3/async_logger/<destination_id>/{active,...}
HETEROLOG_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_RUNNER_INTERVAL_SECOND=5
HETEROLOG_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_LIFECYCLE_INTERVAL_SECOND=60
# circuit breakerの発火条件は通常のlog backendと共通。圧縮log fileは大きいためopen期間のみ5分とする
HETEROLOG_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_CIRCUIT_BREAKER_OPEN_COOLDOWN_SECOND=300
# upload先がRetry-Afterで指定した再送待機の上限（秒）。より長い指定はこの時間に短縮して警告を通知します。
# 正の値が必須です。
HETEROLOG_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_MAX_RETRY_AFTER_SECOND=3600
# doneはupload済みのため既定で削除します。dead・quarantineはuploadできずに保持している
# failure dataで、未設定時は削除しません。trueにすると保持日数・容量で自動削除します。
HETEROLOG_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_ENABLE_PURGE_DONE=true
HETEROLOG_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_DONE_MAX_FILE_AGE_DAYS=30
HETEROLOG_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_DONE_MAX_DIR_SIZE_GB=20
HETEROLOG_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_ENABLE_PURGE_DEAD=false
HETEROLOG_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_DEAD_MAX_FILE_AGE_DAYS=365
HETEROLOG_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_DEAD_MAX_DIR_SIZE_GB=100
HETEROLOG_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_ENABLE_PURGE_QUARANTINE=false
HETEROLOG_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_QUARANTINE_MAX_FILE_AGE_DAYS=365
HETEROLOG_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_QUARANTINE_MAX_DIR_SIZE_GB=100

# compressed log file upload failure spool（Delivery logger）
# 保存先: <HETEROLOG_SYSTEM_LIB_DIR>/<HETEROLOG_TARGET>/spool/objectstorage/s3/delivery_logger/<destination_id>/{active,...}
HETEROLOG_DELIVERY_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_RUNNER_INTERVAL_SECOND=5
HETEROLOG_DELIVERY_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_LIFECYCLE_INTERVAL_SECOND=60
# circuit breakerの発火条件は通常のlog backendと共通。圧縮log fileは大きいためopen期間のみ5分とする
HETEROLOG_DELIVERY_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_CIRCUIT_BREAKER_OPEN_COOLDOWN_SECOND=300
# upload先がRetry-Afterで指定した再送待機の上限（秒）。より長い指定はこの時間に短縮して警告を通知します。
# 正の値が必須です。
HETEROLOG_DELIVERY_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_MAX_RETRY_AFTER_SECOND=3600
# doneはupload済みのため既定で削除します。dead・quarantineはuploadできずに保持している
# failure dataで、未設定時は削除しません。trueにすると保持日数・容量で自動削除します。
HETEROLOG_DELIVERY_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_ENABLE_PURGE_DONE=true
HETEROLOG_DELIVERY_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_DONE_MAX_FILE_AGE_DAYS=90
HETEROLOG_DELIVERY_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_DONE_MAX_DIR_SIZE_GB=100
HETEROLOG_DELIVERY_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_ENABLE_PURGE_DEAD=false
HETEROLOG_DELIVERY_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_DEAD_MAX_FILE_AGE_DAYS=730
HETEROLOG_DELIVERY_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_DEAD_MAX_DIR_SIZE_GB=500
HETEROLOG_DELIVERY_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_ENABLE_PURGE_QUARANTINE=false
HETEROLOG_DELIVERY_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_QUARANTINE_MAX_FILE_AGE_DAYS=730
HETEROLOG_DELIVERY_OBJECT_STORAGE_COMPRESSED_LOG_FILE_UPLOAD_FAILURE_SPOOL_QUARANTINE_MAX_DIR_SIZE_GB=500

#spool runner interval in millisecond
# HETEROLOG_ENABLE_PURGE_*_SPOOL_DONEは再送済みrecordを既定で削除します。DEADは配送不能が確定した
# record、QUARANTINEは成否を確認できないrecordで、未設定時は削除しません。trueにすると
# 保持日数・容量を超えた古いrecordから自動削除します。
HETEROLOG_OPENSEARCH_SPOOL_RUNNER_INTERVAL_MILLISECOND=100
HETEROLOG_ENABLE_OPENSEARCH_SPOOL_RUNNER_STOP_ON_ERROR=false
HETEROLOG_ENABLE_PURGE_OPENSEARCH_SPOOL_DONE=true
HETEROLOG_MAX_OPENSEARCH_SPOOL_DONE_AGE=30
HETEROLOG_MAX_OPENSEARCH_SPOOL_DONE_DIR_SIZE_MB=2048
HETEROLOG_ENABLE_PURGE_OPENSEARCH_SPOOL_DEAD=false
HETEROLOG_MAX_OPENSEARCH_SPOOL_DEAD_AGE=30
HETEROLOG_MAX_OPENSEARCH_SPOOL_DEAD_DIR_SIZE_MB=2048
HETEROLOG_ENABLE_PURGE_OPENSEARCH_SPOOL_QUARANTINE=false
HETEROLOG_MAX_OPENSEARCH_SPOOL_QUARANTINE_AGE=30
HETEROLOG_MAX_OPENSEARCH_SPOOL_QUARANTINE_DIR_SIZE_MB=2048
HETEROLOG_OPENSEARCH_SPOOL_RUNNER_PURGE_INTERVAL_SECOND=60
HETEROLOG_ENABLE_OPENSEARCH_SPOOL_SIZE_ESTIMATE_CACHE=true
HETEROLOG_OPENSEARCH_SPOOL_DIR_FULL_SCAN_EVERY_N_CHECKS=65536
HETEROLOG_MAX_OPENSEARCH_SPOOL_FULL_SCAN_INTERVAL_SECOND=300
HETEROLOG_OPENSEARCH_SPOOL_RUNNER_RETRY_FINALIZE_DELAY_MILLISECOND=1000
HETEROLOG_MAX_OPENSEARCH_SPOOL_FINALIZE_FAILURE_ENTRIES=4098
# 送信先がRetry-Afterで指定した再送待機の上限（秒）。より長い指定はこの時間に短縮して警告を通知します。
# 通常送信で受け取った指定と、spoolに保存済みの待機にも適用します。正の値が必須です。
HETEROLOG_OPENSEARCH_SPOOL_RUNNER_MAX_RETRY_AFTER_SECOND=3600

