# CloudWatch Logs情報
HETEROLOG_CLOUDWATCH_REGION=ap-northeast-1
HETEROLOG_CLOUDWATCH_ENDPOINT=""
HETEROLOG_CLOUDWATCH_LOG_GROUP_NAME="/heterolog/app"
HETEROLOG_CLOUDWATCH_LOG_STREAM_NAME="local-main"
# none=固定名、monthly=/YYYY/MM、daily=/YYYY/MM/DD、hourly=/YYYY/MM/DD/HHを付与する
# suffixはログ発生時刻（Clock）のタイムゾーンに従い、本文表示用のlocal time/timezone設定には従わない
HETEROLOG_CLOUDWATCH_LOG_STREAM_ROTATION=none
HETEROLOG_CLOUDWATCH_TIMEOUT_SECOND=2
HETEROLOG_CLOUDWATCH_AWS_ACCESS_KEY_ID=
HETEROLOG_CLOUDWATCH_AWS_SECRET_ACCESS_KEY=
HETEROLOG_CLOUDWATCH_AWS_SESSION_TOKEN=
HETEROLOG_CLOUDWATCH_HEADERS={}
HETEROLOG_ENABLE_CLOUDWATCH_AUTO_CREATE_LOG_STREAM=false
HETEROLOG_ENABLE_CLOUDWATCH_COMPRESS_REQUEST=true
HETEROLOG_CLOUDWATCH_LOG_LEVEL=INFO
HETEROLOG_ENABLE_CLOUDWATCH_NO_BULK_FLUSH_MODE=false
HETEROLOG_CLOUDWATCH_FLUSH_INTERVAL_SECOND=5
# buffer内のevent件数またはPutLogEvents計算式によるbyte概算が到達した場合にflushする
HETEROLOG_CLOUDWATCH_BUFFER_FLUSH_MAX_EVENTS=500
HETEROLOG_CLOUDWATCH_BUFFER_FLUSH_BYTES=524288
# fallback送信待ちとして保持できる最大event数。通常のflush件数以上を指定する
HETEROLOG_MAX_CLOUDWATCH_FALLBACK_QUEUE_EVENTS=1000
HETEROLOG_ENABLE_CLOUDWATCH_PUT_LATENCY=true
HETEROLOG_ENABLE_LOG_CLOUDWATCH_SAMPLING=false
HETEROLOG_ENABLE_LOGGING_CLOUDWATCH_BY_REQUEST_ID=true
HETEROLOG_LOG_CLOUDWATCH_REQUEST_ID_RATE=10
HETEROLOG_LOG_CLOUDWATCH_DEBUG_RATE=10
HETEROLOG_LOG_CLOUDWATCH_INFO_RATE=1000
HETEROLOG_LOG_CLOUDWATCH_WARN_RATE=10
HETEROLOG_LOG_CLOUDWATCH_ERROR_RATE=1
HETEROLOG_CLOUDWATCH_LOGGER_ERROR_HANDLER=stdout
HETEROLOG_CLOUDWATCH_LOGGER_WARN_HANDLER=stdout
HETEROLOG_CLOUDWATCH_LOGGER_INFO_HANDLER=stdout
HETEROLOG_CLOUDWATCH_LOGGER_DEBUG_HANDLER=stdout
