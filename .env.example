# OpenSearch登録失敗時のハンドリング設定
# *_DURABLE_TYPES / *_DEGRADE_TYPESは未設定・空文字・空白だけならkey固有のdefaultを使います。
# sync/asyncのDURABLE_TYPESはnone、spool、fileArchive、spool,fileArchiveから選択できます。
# DeliveryのDURABLE_TYPESはnoneまたはfileArchiveを選択できます。
# DURABLE_TYPESの選択なしはnoneを単独指定してください。
# DURABLE_TYPES=noneの場合だけ、HETEROLOG_ENABLE_*_DEGRADEがDEGRADE_TYPESへの直接退避を制御します。
# DURABLE_TYPES=noneの場合だけ、overload判定を行わずDEGRADE_TYPESへ直接退避する
HETEROLOG_ENABLE_OPENSEARCH_DEGRADE=true
HETEROLOG_MAX_OPENSEARCH_FAILURE_HANDLER_CONCURRENT=8
HETEROLOG_OPENSEARCH_DURABLE_TYPES=spool
# DEGRADE_TYPESはstdoutのみ実装済み。s3,nfsは予約値で、指定すると起動時エラーになります。
HETEROLOG_OPENSEARCH_DEGRADE_TYPES=stdout
HETEROLOG_MAX_OPENSEARCH_DURABLE_FILE_ARCHIVE_SIZE_MB=50
# disable=compress/upload/purgeを実行しない（保存・rotationは継続）, inline=failure handlerで実行, runner=専用runnerで周期実行
HETEROLOG_OPENSEARCH_DURABLE_FILE_ARCHIVE_LIFECYCLE_MODE=inline
HETEROLOG_OPENSEARCH_FAILURE_ARCHIVE_DIR="opensearch_failure_archives"
HETEROLOG_OPENSEARCH_ENABLE_DURABLE_FILE_ARCHIVE_ROTATE=true
# 保持世代数・保持日数・ディレクトリ上限(MB)。0は上限なしで、その条件では削除しません（既定）。
# 0以外は世代数2以上・日数1以上・上限10以上かつファイル最大サイズ以上。空き容量がHETEROLOG_MIN_AVAILABLE_DISK_SPACE_GB未満の間は、新しい失敗をarchiveへ保存せずOVERLOAD_POLICYで処理します。
HETEROLOG_MAX_OPENSEARCH_ENABLE_DURABLE_FILE_ARCHIVE_BACKUPS=0
HETEROLOG_MAX_OPENSEARCH_ENABLE_DURABLE_FILE_ARCHIVE_AGE=0
HETEROLOG_MAX_OPENSEARCH_ENABLE_DURABLE_FILE_ARCHIVE_DIR_SIZE_MB=0
HETEROLOG_ENABLE_OPENSEARCH_DURABLE_FILE_ARCHIVE_COMPRESS=true
# gzip or zstd or lz4 or xz
HETEROLOG_OPENSEARCH_DURABLE_FILE_ARCHIVE_COMPRESS_FORMAT=zstd
# daily or weekly or monthly（weeklyはUTCの日曜日0時から新しいファイル）
HETEROLOG_OPENSEARCH_DURABLE_FILE_ARCHIVE_ROTATION=daily
# ローテーション済み failure archive をS3へupload（object keyは prefix/retryable または prefix/permanent 配下）
HETEROLOG_ENABLE_OPENSEARCH_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_UPLOAD=false
HETEROLOG_OPENSEARCH_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_UPLOAD_TYPE=s3
HETEROLOG_OPENSEARCH_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_S3_BUCKET=
HETEROLOG_OPENSEARCH_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_S3_PREFIX=
# archiveのoverload時にdropするか、SECONDARY_DESTINATIONへdegradeするかをこの値で判定します。
# 設定可能値: drop, degrade
HETEROLOG_OPENSEARCH_DURABLE_FILE_ARCHIVE_OVERLOAD_POLICY=drop
HETEROLOG_OPENSEARCH_DURABLE_FILE_ARCHIVE_SECONDARY_DESTINATION=stdout
# failure archive自身の内部ログを通知する出力先（カンマ区切り）。
HETEROLOG_OPENSEARCH_DURABLE_FILE_ERROR_HANDLER=stdout
HETEROLOG_OPENSEARCH_DURABLE_FILE_WARN_HANDLER=stdout
HETEROLOG_OPENSEARCH_DURABLE_FILE_INFO_HANDLER=stdout
HETEROLOG_OPENSEARCH_DURABLE_FILE_DEBUG_HANDLER=stdout

# Optional: override log directory
# 保存先の基点directory。省略時の既定値はOSと実行するuserで決まります。
#   Linux・BSD・illumos・Solaris・AIX: rootで動く場合はログが/var/log、spoolと状態が/var/libです。
#     rootで動かない場合は、すべて$XDG_STATE_HOME（未設定か絶対パスでない場合は~/.local/state）です。
#     ~/.local/stateを使う場合にhome directoryが分からないときは、rootと同じです。
#   macOS: ログが~/Library/Logs、spoolと状態が~/Library/Application Supportです。
#   Windows: すべて%LOCALAPPDATA%です。
# 下の値はLinuxをrootで動かす場合の既定値です。
# HETEROLOG_SYSTEM_LOG_DIR="/var/log"
# HETEROLOG_SYSTEM_LIB_DIR="/var/lib"   ex.) /var/lib/appname/spool
# failure archiveと、object storage archiveの宛先別進捗・有効状態を保存するbase directory
# HETEROLOG_APP_STATE_DIR="/var/lib"
# 保存先の基点と通常ログの設定ディレクトリはリンクを許可し、構築時に実体パスへ固定します。
# 基点配下のアプリ管理用ディレクトリ（archive-checkpoints、spool以下、
# failure archiveの分類など）にはシンボリックリンク・junctionを使用できません。
# 稼働中に外部からディレクトリを削除・置換する操作はサポートしません。

# OpenSearch非同期送信失敗時のハンドリング設定
# DURABLE_TYPES=noneの場合だけ、overload判定を行わずDEGRADE_TYPESへ直接退避する
HETEROLOG_ENABLE_ASYNC_OPENSEARCH_DEGRADE=true
HETEROLOG_MAX_ASYNC_OPENSEARCH_FAILURE_HANDLER_CONCURRENT=8
HETEROLOG_ASYNC_OPENSEARCH_DURABLE_TYPES=spool
# DEGRADE_TYPESはstdoutのみ実装済み。s3,nfsは予約値で、指定すると起動時エラーになります。
HETEROLOG_ASYNC_OPENSEARCH_DEGRADE_TYPES=stdout
HETEROLOG_MAX_ASYNC_OPENSEARCH_DURABLE_FILE_ARCHIVE_SIZE_MB=50
# disable=compress/upload/purgeを実行しない（保存・rotationは継続）, inline=failure handlerで実行, runner=専用runnerで周期実行
HETEROLOG_ASYNC_OPENSEARCH_DURABLE_FILE_ARCHIVE_LIFECYCLE_MODE=inline
HETEROLOG_ASYNC_OPENSEARCH_FAILURE_ARCHIVE_DIR="async_opensearch_failure_archives"
HETEROLOG_ASYNC_OPENSEARCH_ENABLE_DURABLE_FILE_ARCHIVE_ROTATE=true
# 保持世代数・保持日数・ディレクトリ上限(MB)。0は上限なしで、その条件では削除しません（既定）。
# 0以外は世代数2以上・日数1以上・上限10以上かつファイル最大サイズ以上。空き容量がHETEROLOG_MIN_AVAILABLE_DISK_SPACE_GB未満の間は、新しい失敗をarchiveへ保存せずOVERLOAD_POLICYで処理します。
HETEROLOG_MAX_ASYNC_OPENSEARCH_ENABLE_DURABLE_FILE_ARCHIVE_BACKUPS=0
HETEROLOG_MAX_ASYNC_OPENSEARCH_ENABLE_DURABLE_FILE_ARCHIVE_AGE=0
HETEROLOG_MAX_ASYNC_OPENSEARCH_ENABLE_DURABLE_FILE_ARCHIVE_DIR_SIZE_MB=0
HETEROLOG_ENABLE_ASYNC_OPENSEARCH_DURABLE_FILE_ARCHIVE_COMPRESS=true
# gzip or zstd or lz4 or xz
HETEROLOG_ASYNC_OPENSEARCH_DURABLE_FILE_ARCHIVE_COMPRESS_FORMAT=zstd
# daily or weekly or monthly（weeklyはUTCの日曜日0時から新しいファイル）
HETEROLOG_ASYNC_OPENSEARCH_DURABLE_FILE_ARCHIVE_ROTATION=daily
# ローテーション済み failure archive をS3へupload（object keyは prefix/retryable または prefix/permanent 配下）
HETEROLOG_ENABLE_ASYNC_OPENSEARCH_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_UPLOAD=false
HETEROLOG_ASYNC_OPENSEARCH_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_UPLOAD_TYPE=s3
HETEROLOG_ASYNC_OPENSEARCH_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_S3_BUCKET=
HETEROLOG_ASYNC_OPENSEARCH_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_S3_PREFIX=
HETEROLOG_ASYNC_OPENSEARCH_DURABLE_FILE_ARCHIVE_OVERLOAD_POLICY=drop
HETEROLOG_ASYNC_OPENSEARCH_DURABLE_FILE_ARCHIVE_SECONDARY_DESTINATION=stdout
# 非同期loggerのfailure archive自身の内部ログを通知する出力先（カンマ区切り）。
HETEROLOG_ASYNC_OPENSEARCH_DURABLE_FILE_ERROR_HANDLER=stdout
HETEROLOG_ASYNC_OPENSEARCH_DURABLE_FILE_WARN_HANDLER=stdout
HETEROLOG_ASYNC_OPENSEARCH_DURABLE_FILE_INFO_HANDLER=stdout
HETEROLOG_ASYNC_OPENSEARCH_DURABLE_FILE_DEBUG_HANDLER=stdout

# 送達確認ロガー OpenSearch登録失敗時のハンドリング設定
# DURABLE_TYPES=noneの場合だけ、overload判定を行わずDEGRADE_TYPESへ直接退避する
HETEROLOG_ENABLE_DELIVERY_OPENSEARCH_DEGRADE=true
HETEROLOG_DELIVERY_OPENSEARCH_DURABLE_TYPES=fileArchive
# DEGRADE_TYPESはstdoutのみ実装済み。s3,nfsは予約値で、指定すると起動時エラーになります。
HETEROLOG_DELIVERY_OPENSEARCH_DEGRADE_TYPES=stdout
HETEROLOG_MAX_DELIVERY_OPENSEARCH_DURABLE_FILE_ARCHIVE_SIZE_MB=50
# disable=compress/upload/purgeを実行しない（保存・rotationは継続）, inline=failure handlerで実行, runner=専用runnerで周期実行
HETEROLOG_DELIVERY_OPENSEARCH_DURABLE_FILE_ARCHIVE_LIFECYCLE_MODE=inline
HETEROLOG_DELIVERY_OPENSEARCH_FAILURE_ARCHIVE_DIR="delivery_opensearch_failure_archives"
HETEROLOG_DELIVERY_OPENSEARCH_ENABLE_DURABLE_FILE_ARCHIVE_ROTATE=true
# 保持世代数・保持日数・ディレクトリ上限(MB)。0は上限なしで、その条件では削除しません（既定）。
# 0以外は世代数2以上・日数1以上・上限10以上かつファイル最大サイズ以上。空き容量がHETEROLOG_MIN_AVAILABLE_DISK_SPACE_GB未満の間は、新しい失敗をarchiveへ保存せずOVERLOAD_POLICYで処理します。
HETEROLOG_MAX_DELIVERY_OPENSEARCH_ENABLE_DURABLE_FILE_ARCHIVE_BACKUPS=0
HETEROLOG_MAX_DELIVERY_OPENSEARCH_ENABLE_DURABLE_FILE_ARCHIVE_AGE=0
HETEROLOG_MAX_DELIVERY_OPENSEARCH_ENABLE_DURABLE_FILE_ARCHIVE_DIR_SIZE_MB=0
HETEROLOG_ENABLE_DELIVERY_OPENSEARCH_DURABLE_FILE_ARCHIVE_COMPRESS=true
# gzip or zstd or lz4 or xz
HETEROLOG_DELIVERY_OPENSEARCH_DURABLE_FILE_ARCHIVE_COMPRESS_FORMAT=zstd
# daily or weekly or monthly（weeklyはUTCの日曜日0時から新しいファイル）
HETEROLOG_DELIVERY_OPENSEARCH_DURABLE_FILE_ARCHIVE_ROTATION=daily
# ローテーション済み failure archive をS3へupload（object keyは prefix/retryable または prefix/permanent 配下）
HETEROLOG_ENABLE_DELIVERY_OPENSEARCH_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_UPLOAD=false
HETEROLOG_DELIVERY_OPENSEARCH_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_UPLOAD_TYPE=s3
HETEROLOG_DELIVERY_OPENSEARCH_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_S3_BUCKET=
HETEROLOG_DELIVERY_OPENSEARCH_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_S3_PREFIX=
HETEROLOG_DELIVERY_OPENSEARCH_DURABLE_FILE_ARCHIVE_OVERLOAD_POLICY=drop
HETEROLOG_DELIVERY_OPENSEARCH_DURABLE_FILE_ARCHIVE_SECONDARY_DESTINATION=stdout
HETEROLOG_DELIVERY_OPENSEARCH_DURABLE_FILE_ERROR_HANDLER=stdout
HETEROLOG_DELIVERY_OPENSEARCH_DURABLE_FILE_WARN_HANDLER=stdout
HETEROLOG_DELIVERY_OPENSEARCH_DURABLE_FILE_INFO_HANDLER=stdout
HETEROLOG_DELIVERY_OPENSEARCH_DURABLE_FILE_DEBUG_HANDLER=stdout
# sync・async・deliveryのfailure archive内でretryable/permanentを分ける子directory
# HETEROLOG_OPENSEARCH_DURABLE_RETRYABLE_DIR="retryable"
# HETEROLOG_OPENSEARCH_DURABLE_PERMANENT_DIR="permanent"
HETEROLOG_ASYNC_OPENSEARCH_DURABLE_RETRYABLE_DIR="retryable"
HETEROLOG_ASYNC_OPENSEARCH_DURABLE_PERMANENT_DIR="permanent"
# HETEROLOG_DELIVERY_OPENSEARCH_DURABLE_RETRYABLE_DIR="retryable"
# HETEROLOG_DELIVERY_OPENSEARCH_DURABLE_PERMANENT_DIR="permanent"
# overload判定にメモリ逼迫率を使用
HETEROLOG_USE_MEMORY_PRESSURE_OPENSEARCH_SPOOL_OVERLOAD=false

# spool
HETEROLOG_OPENSEARCH_FAILURE_SPOOL_DIR="opensearch"
# spoolのoverload時にdropするか、SECONDARY_DESTINATIONへdegradeするかをこの値で判定します。
# 設定可能値: drop, degrade
HETEROLOG_OPENSEARCH_SPOOL_OVERLOAD_POLICY=drop
HETEROLOG_OPENSEARCH_SPOOL_SECONDARY_DESTINATION=stdout
HETEROLOG_MAX_OPENSEARCH_SPOOL_FILE_ACTIVE_DIR_SIZE_MB=1024
# active spoolの最古データがこの日数より古い場合にWarn通知する（保存は拒否しない。0で無効）
HETEROLOG_OPENSEARCH_ACTIVE_SPOOL_BACKLOG_WARN_AFTER_DAYS=120
HETEROLOG_OPENSEARCH_SPOOL_FILE_ERROR_HANDLER=stdout
HETEROLOG_OPENSEARCH_SPOOL_FILE_WARN_HANDLER=stdout
HETEROLOG_OPENSEARCH_SPOOL_FILE_INFO_HANDLER=stdout
HETEROLOG_OPENSEARCH_SPOOL_FILE_DEBUG_HANDLER=stdout
# 非同期ロガーspool
HETEROLOG_ASYNC_OPENSEARCH_FAILURE_SPOOL_DIR="opensearch_async"
# overload判定にメモリ逼迫率を使用
HETEROLOG_USE_MEMORY_PRESSURE_ASYNC_OPENSEARCH_SPOOL_OVERLOAD=false
HETEROLOG_ASYNC_OPENSEARCH_SPOOL_OVERLOAD_POLICY=drop
HETEROLOG_ASYNC_OPENSEARCH_SPOOL_SECONDARY_DESTINATION=stdout
HETEROLOG_MAX_ASYNC_OPENSEARCH_SPOOL_FILE_ACTIVE_DIR_SIZE_MB=1024
HETEROLOG_MAX_ASYNC_OPENSEARCH_SPOOL_SCANNED_CACHE_USAGE_COUNT=100000
HETEROLOG_ASYNC_OPENSEARCH_SPOOL_CACHE_LIFETIME_SECOND=30
# active spoolの最古データがこの日数より古い場合にWarn通知する（保存は拒否しない。0で無効）
HETEROLOG_ASYNC_OPENSEARCH_ACTIVE_SPOOL_BACKLOG_WARN_AFTER_DAYS=120
HETEROLOG_ASYNC_OPENSEARCH_SPOOL_FILE_ERROR_HANDLER=stdout
HETEROLOG_ASYNC_OPENSEARCH_SPOOL_FILE_WARN_HANDLER=stdout
HETEROLOG_ASYNC_OPENSEARCH_SPOOL_FILE_INFO_HANDLER=stdout
HETEROLOG_ASYNC_OPENSEARCH_SPOOL_FILE_DEBUG_HANDLER=stdout
# 共通項目
# 保存先の空き容量（GiB単位）がこの値を下回る間は、file loggerの書き込みと、spool・failure archiveへの
# 新しい保存を行いません。0なら判定しませんが、failure archiveを使う場合は0にできません。
HETEROLOG_MIN_AVAILABLE_DISK_SPACE_GB=1
# filesystemから実測した使用量の概算値を、再走査なしで利用できる秒数です。
# TTL経過後の次のログ書き込みで再走査します。概算値が上限を超えた場合はTTL経過を待ちませんが、
# 直前の走査とpurgeの後にも上限を超えていた場合は、TTLが経過するまで再走査しません。
HETEROLOG_INLINE_FILESYSTEM_USAGE_CACHE_TTL_SECOND=900
HETEROLOG_MAX_OPENSEARCH_SPOOL_SCANNED_CACHE_USAGE_COUNT=100000
HETEROLOG_OPENSEARCH_SPOOL_CACHE_LIFETIME_SECOND=30

# OpenSearch情報
HETEROLOG_OPENSEARCH_ENDPOINT="https://localhost:9200"
HETEROLOG_OPENSEARCH_USERNAME=
HETEROLOG_OPENSEARCH_PASSWORD=
HETEROLOG_OPENSEARCH_INDEX="app-log-heterolog"
HETEROLOG_OPENSEARCH_SKIP_VERIFY_SSL=true
# 1回のHTTP requestの上限（秒）。未設定時も1秒です（Loki・ClickHouse・CloudWatch Logsの
# *_TIMEOUT_SECONDは未設定時も2秒）。
HETEROLOG_OPENSEARCH_TIMEOUT_SECOND=1
# OpenSearchバルク送信不要設定（1件づつ送信）
HETEROLOG_ENABLE_OPENSEARCH_NO_BULK_FLUSH_MODE=false
# 秒単位
HETEROLOG_OPENSEARCH_FLUSH_INTERVALS=5
HETEROLOG_MAX_BULK_DOCUMENT_OPENSEARCH_FLUSH=500
# buffer内のログ本文がこの概算byte数に達したら、時間・件数条件より先にflushします。
HETEROLOG_OPENSEARCH_BUFFER_FLUSH_BYTES=5242880
# 1回のBulk requestへまとめる圧縮前NDJSONの上限（バイト）。超過分は別requestへ分割します。
# OpenSearchや通信経路上のproxyが拒否する上限より余裕を持たせて指定してください。
HETEROLOG_MAX_OPENSEARCH_BULK_REQUEST_BYTES=15728640

# Loki情報
HETEROLOG_LOKI_ENDPOINT="http://localhost:3100"
HETEROLOG_LOKI_TENANT_ID=""
HETEROLOG_LOKI_USERNAME=""
HETEROLOG_LOKI_PASSWORD=
HETEROLOG_LOKI_BEARER_TOKEN=
# 追加するHTTP headerのJSON object。認証情報を含み得るため、不正なJSONの場合も設定エラーには
# keyだけを示し、値は表示しません（各LoggerContractKindのLoki・CloudWatch Logs・ClickHouseの
# headerも同じです）。
HETEROLOG_LOKI_HEADERS={}
HETEROLOG_LOKI_TIMEOUT_SECOND=2
HETEROLOG_ENABLE_LOKI_COMPRESS_REQUEST=true
HETEROLOG_LOKI_LOG_LEVEL=INFO
HETEROLOG_ENABLE_LOKI_NO_BULK_FLUSH_MODE=false
HETEROLOG_LOKI_FLUSH_INTERVAL_SECOND=5
HETEROLOG_MAX_LOKI_PUSH_ENTRIES=500
# formatter後のline byte概算合計が到達した場合に、件数・時間より先にflushする
HETEROLOG_LOKI_BUFFER_FLUSH_BYTES=1048576
# fallback送信待ちとして保持できる最大entry数。通常のflush件数以上を指定する
HETEROLOG_MAX_LOKI_FALLBACK_QUEUE_ENTRIES=1000
# Lokiまたはgateway側の制限に合わせる。1行上限はPush request上限未満にする
# 実際の上限との不一致は送信errorになり、application側では自動補正しない
HETEROLOG_MAX_LOKI_LINE_BYTES=262144
HETEROLOG_MAX_LOKI_PUSH_REQUEST_BYTES=4194304
HETEROLOG_ENABLE_LOKI_PUSH_LATENCY=true
HETEROLOG_ENABLE_LOG_LOKI_SAMPLING=false
HETEROLOG_ENABLE_LOGGING_LOKI_BY_REQUEST_ID=true
HETEROLOG_LOG_LOKI_REQUEST_ID_RATE=10
HETEROLOG_LOG_LOKI_DEBUG_RATE=10
HETEROLOG_LOG_LOKI_INFO_RATE=1000
HETEROLOG_LOG_LOKI_WARN_RATE=10
HETEROLOG_LOG_LOKI_ERROR_RATE=1
HETEROLOG_LOKI_LOGGER_ERROR_HANDLER=stdout
HETEROLOG_LOKI_LOGGER_WARN_HANDLER=stdout
HETEROLOG_LOKI_LOGGER_INFO_HANDLER=stdout
HETEROLOG_LOKI_LOGGER_DEBUG_HANDLER=stdout
# 直後の *_RETRY_CLIENT_MODE には次のいずれかを指定する（各行の「# -」直後の名前が設定値）:
# - none: raw client。retryもcircuit breakerも適用しない
# - retry: RetryingClient -> raw client。timeout・接続断・一時的なHTTPエラーなど、再試行可能と判定された失敗をMaxAttemptsまで再試行する。待機時間はBaseDelayずつ増やし、MaxDelayを上限とする
# - retry_policy: RetryPolicyClient -> raw client。恒久エラー・親context終了・breaker openは1回、timeout・EOF・接続断・HTTP 408・500・504は最大2回、HTTP 502・503・throttlingはMaxAttemptsまで試行する。429・503のRetry-Afterとcontext残時間も考慮する
# - circuit_breaker: CircuitBreakerClient -> raw client。retryは行わず、連続障害時はcooldown中の接続を抑止する
# - retry_with_breaker: RetryingClient -> CircuitBreakerClient -> raw client。RetryingClientによる各試行をbreakerが監視し、open後は残りの試行を抑止する
# - retry_policy_with_breaker: RetryPolicyClient -> CircuitBreakerClient -> raw client。RetryPolicyClientによる各試行をbreakerが監視し、open後は残りの試行を抑止する
HETEROLOG_LOKI_RETRY_CLIENT_MODE=retry_policy
# Lokiは冪等性を保証しない。欠損回避を優先し、重複ログを許容するat-least-onceとして再送する
# circuit breakerを含むmodeではopen中の接続をskipし、cooldown後は1件だけprobeとして通す（固定動作）
# 初回の送信に加える再試行の回数。0なら再試行しません（再試行するmodeでは、負の値はエラー）
HETEROLOG_MAX_LOKI_RETRYABLE_CLIENT_RETRIES=2
# 再試行の前に待つ時間の基準と上限（ミリ秒）。再試行するmodeでは、0以下はエラー
HETEROLOG_LOKI_RETRYABLE_CLIENT_MILLISECOND=200
HETEROLOG_MAX_LOKI_RETRYABLE_CLIENT_DELAY_MILLISECOND=1000
# Loki情報Async
HETEROLOG_ASYNC_LOKI_ENDPOINT="http://localhost:3100"
HETEROLOG_ASYNC_LOKI_TENANT_ID=""
HETEROLOG_ASYNC_LOKI_USERNAME=""
HETEROLOG_ASYNC_LOKI_PASSWORD=
HETEROLOG_ASYNC_LOKI_BEARER_TOKEN=
HETEROLOG_ASYNC_LOKI_HEADERS={}
HETEROLOG_ASYNC_LOKI_TIMEOUT_SECOND=2
HETEROLOG_ENABLE_ASYNC_LOKI_COMPRESS_REQUEST=true
HETEROLOG_ASYNC_LOKI_LOG_LEVEL=INFO
HETEROLOG_ASYNC_LOKI_FLUSH_INTERVAL_SECOND=5
HETEROLOG_MAX_ASYNC_LOKI_PUSH_ENTRIES=500
# formatter後のline byte概算合計が到達した場合に、件数・時間より先にflushする
HETEROLOG_ASYNC_LOKI_BUFFER_FLUSH_BYTES=1048576
# fallback送信待ちとして保持できる最大entry数。通常のflush件数以上を指定する
HETEROLOG_MAX_ASYNC_LOKI_FALLBACK_QUEUE_ENTRIES=1000
# Lokiまたはgateway側の制限に合わせる。1行上限はPush request上限未満にする
# 実際の上限との不一致は送信errorになり、application側では自動補正しない
HETEROLOG_MAX_ASYNC_LOKI_LINE_BYTES=262144
HETEROLOG_MAX_ASYNC_LOKI_PUSH_REQUEST_BYTES=4194304
HETEROLOG_ENABLE_ASYNC_LOKI_PUSH_LATENCY=true
HETEROLOG_ENABLE_ASYNC_LOG_LOKI_SAMPLING=false
HETEROLOG_ENABLE_ASYNC_LOGGING_LOKI_BY_REQUEST_ID=true
HETEROLOG_ASYNC_LOG_LOKI_REQUEST_ID_RATE=10
HETEROLOG_ASYNC_LOG_LOKI_DEBUG_RATE=10
HETEROLOG_ASYNC_LOG_LOKI_INFO_RATE=1000
HETEROLOG_ASYNC_LOG_LOKI_WARN_RATE=10
HETEROLOG_ASYNC_LOG_LOKI_ERROR_RATE=1
HETEROLOG_ASYNC_LOKI_LOGGER_ERROR_HANDLER=stdout
HETEROLOG_ASYNC_LOKI_LOGGER_WARN_HANDLER=stdout
HETEROLOG_ASYNC_LOKI_LOGGER_INFO_HANDLER=stdout
HETEROLOG_ASYNC_LOKI_LOGGER_DEBUG_HANDLER=stdout
# 直後の *_RETRY_CLIENT_MODE には次のいずれかを指定する（各行の「# -」直後の名前が設定値）:
# - none: raw client。retryもcircuit breakerも適用しない
# - retry: RetryingClient -> raw client。timeout・接続断・一時的なHTTPエラーなど、再試行可能と判定された失敗をMaxAttemptsまで再試行する。待機時間はBaseDelayずつ増やし、MaxDelayを上限とする
# - retry_policy: RetryPolicyClient -> raw client。恒久エラー・親context終了・breaker openは1回、timeout・EOF・接続断・HTTP 408・500・504は最大2回、HTTP 502・503・throttlingはMaxAttemptsまで試行する。429・503のRetry-Afterとcontext残時間も考慮する
# - circuit_breaker: CircuitBreakerClient -> raw client。retryは行わず、連続障害時はcooldown中の接続を抑止する
# - retry_with_breaker: RetryingClient -> CircuitBreakerClient -> raw client。RetryingClientによる各試行をbreakerが監視し、open後は残りの試行を抑止する
# - retry_policy_with_breaker: RetryPolicyClient -> CircuitBreakerClient -> raw client。RetryPolicyClientによる各試行をbreakerが監視し、open後は残りの試行を抑止する
HETEROLOG_ASYNC_LOKI_RETRY_CLIENT_MODE=retry_policy
# Lokiは冪等性を保証しない。欠損回避を優先し、重複ログを許容するat-least-onceとして再送する
# circuit breakerを含むmodeではopen中の接続をskipし、cooldown後は1件だけprobeとして通す（固定動作）
# 初回の送信に加える再試行の回数。0なら再試行しません（再試行するmodeでは、負の値はエラー）
HETEROLOG_MAX_ASYNC_LOKI_RETRYABLE_CLIENT_RETRIES=2
# 再試行の前に待つ時間の基準と上限（ミリ秒）。再試行するmodeでは、0以下はエラー
HETEROLOG_ASYNC_LOKI_RETRYABLE_CLIENT_MILLISECOND=200
HETEROLOG_MAX_ASYNC_LOKI_RETRYABLE_CLIENT_DELAY_MILLISECOND=1000
# 送達確認ロガー Loki
HETEROLOG_DELIVERY_LOKI_ENDPOINT="http://localhost:3100"
HETEROLOG_DELIVERY_LOKI_TENANT_ID=""
HETEROLOG_DELIVERY_LOKI_USERNAME=""
HETEROLOG_DELIVERY_LOKI_PASSWORD=
HETEROLOG_DELIVERY_LOKI_BEARER_TOKEN=
HETEROLOG_DELIVERY_LOKI_HEADERS={}
HETEROLOG_DELIVERY_LOKI_TIMEOUT_SECOND=2
HETEROLOG_ENABLE_DELIVERY_LOKI_COMPRESS_REQUEST=true
HETEROLOG_ENABLE_DELIVERY_LOKI_PUSH_LATENCY=true
# Lokiまたはgateway側の制限に合わせる。1行上限はPush request上限未満にする
# 実際の上限との不一致は送信errorになり、application側では自動補正しない
HETEROLOG_MAX_DELIVERY_LOKI_LINE_BYTES=262144
HETEROLOG_MAX_DELIVERY_LOKI_PUSH_REQUEST_BYTES=4194304
# 直後の *_RETRY_CLIENT_MODE には次のいずれかを指定する（各行の「# -」直後の名前が設定値）:
# - none: raw client。retryもcircuit breakerも適用しない
# - retry: RetryingClient -> raw client。timeout・接続断・一時的なHTTPエラーなど、再試行可能と判定された失敗をMaxAttemptsまで再試行する。待機時間はBaseDelayずつ増やし、MaxDelayを上限とする
# - retry_policy: RetryPolicyClient -> raw client。恒久エラー・親context終了・breaker openは1回、timeout・EOF・接続断・HTTP 408・500・504は最大2回、HTTP 502・503・throttlingはMaxAttemptsまで試行する。429・503のRetry-Afterとcontext残時間も考慮する
# - circuit_breaker: CircuitBreakerClient -> raw client。retryは行わず、連続障害時はcooldown中の接続を抑止する
# - retry_with_breaker: RetryingClient -> CircuitBreakerClient -> raw client。RetryingClientによる各試行をbreakerが監視し、open後は残りの試行を抑止する
# - retry_policy_with_breaker: RetryPolicyClient -> CircuitBreakerClient -> raw client。RetryPolicyClientによる各試行をbreakerが監視し、open後は残りの試行を抑止する
HETEROLOG_DELIVERY_LOKI_RETRY_CLIENT_MODE=retry_policy
# Lokiは冪等性を保証しない。欠損回避を優先し、重複ログを許容するat-least-onceとして再送する
# circuit breakerを含むmodeではopen中の接続をskipし、cooldown後は1件だけprobeとして通す（固定動作）
# 初回の送信に加える再試行の回数。0なら再試行しません（再試行するmodeでは、負の値はエラー）
HETEROLOG_MAX_DELIVERY_LOKI_RETRYABLE_CLIENT_RETRIES=2
# 再試行の前に待つ時間の基準と上限（ミリ秒）。再試行するmodeでは、0以下はエラー
HETEROLOG_DELIVERY_LOKI_RETRYABLE_CLIENT_MILLISECOND=200
HETEROLOG_MAX_DELIVERY_LOKI_RETRYABLE_CLIENT_DELAY_MILLISECOND=1000

# ClickHouse
HETEROLOG_CLICKHOUSE_ENDPOINT="http://localhost:8123"
HETEROLOG_CLICKHOUSE_DATABASE="default"
HETEROLOG_CLICKHOUSE_TABLE="app_logs"
HETEROLOG_CLICKHOUSE_USERNAME="default"
HETEROLOG_CLICKHOUSE_PASSWORD=
HETEROLOG_CLICKHOUSE_TIMEOUT_SECOND=2
HETEROLOG_CLICKHOUSE_HEADERS={}
HETEROLOG_ENABLE_CLICKHOUSE_COMPRESS_REQUEST=true
HETEROLOG_CLICKHOUSE_LOG_LEVEL=INFO
HETEROLOG_CLICKHOUSE_FLUSH_INTERVAL_SECOND=5
HETEROLOG_MAX_CLICKHOUSE_INSERT_ENTRIES=10000
# JSONEachRowの概算合計が到達した場合に、件数・時間より先にflushする
HETEROLOG_CLICKHOUSE_BUFFER_FLUSH_BYTES=5242880
# fallback送信中に保持する最大件数。到達時は最古のログから破棄する
HETEROLOG_MAX_CLICKHOUSE_FALLBACK_QUEUE_ENTRIES=10000
# 一回の物理INSERT request上限。ClickHouse、proxy等の実効上限より余裕を持たせる
HETEROLOG_MAX_CLICKHOUSE_INSERT_REQUEST_BYTES=16777216
HETEROLOG_ENABLE_CLICKHOUSE_INSERT_LATENCY=true
HETEROLOG_ENABLE_LOG_CLICKHOUSE_SAMPLING=false
HETEROLOG_ENABLE_LOGGING_CLICKHOUSE_BY_REQUEST_ID=true
HETEROLOG_LOG_CLICKHOUSE_REQUEST_ID_RATE=10
HETEROLOG_LOG_CLICKHOUSE_DEBUG_RATE=10
HETEROLOG_LOG_CLICKHOUSE_INFO_RATE=1000
HETEROLOG_LOG_CLICKHOUSE_WARN_RATE=10
HETEROLOG_LOG_CLICKHOUSE_ERROR_RATE=1
HETEROLOG_CLICKHOUSE_LOGGER_ERROR_HANDLER=stdout
HETEROLOG_CLICKHOUSE_LOGGER_WARN_HANDLER=stdout
HETEROLOG_CLICKHOUSE_LOGGER_INFO_HANDLER=stdout
HETEROLOG_CLICKHOUSE_LOGGER_DEBUG_HANDLER=stdout
# 直後の *_RETRY_CLIENT_MODE には次のいずれかを指定する（各行の「# -」直後の名前が設定値）:
# - none: raw client。retryもcircuit breakerも適用しない
# - retry: RetryingClient -> raw client。timeout・接続断・一時的なHTTPエラーなど、再試行可能と判定された失敗をMaxAttemptsまで再試行する。待機時間はBaseDelayずつ増やし、MaxDelayを上限とする
