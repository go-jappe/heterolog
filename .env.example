# CloudWatch Logsは冪等性を保証しない。欠損回避を優先し、重複ログを許容するat-least-onceとして再送する
# circuit breakerを含むmodeではopen中の接続をskipし、cooldown後は1件だけprobeとして通す（固定動作）
# 初回の送信に加える再試行の回数。0なら再試行しません（再試行するmodeでは、負の値はエラー）
HETEROLOG_MAX_ASYNC_CLOUDWATCH_RETRYABLE_CLIENT_RETRIES=2
# 再試行の前に待つ時間の基準と上限（ミリ秒）。再試行するmodeでは、0以下はエラー
HETEROLOG_ASYNC_CLOUDWATCH_RETRYABLE_CLIENT_MILLISECOND=200
HETEROLOG_MAX_ASYNC_CLOUDWATCH_RETRYABLE_CLIENT_DELAY_MILLISECOND=1000

# 送達確認ロガー CloudWatch Logs
HETEROLOG_DELIVERY_CLOUDWATCH_REGION=ap-northeast-1
HETEROLOG_DELIVERY_CLOUDWATCH_ENDPOINT=""
HETEROLOG_DELIVERY_CLOUDWATCH_LOG_GROUP_NAME="/heterolog/app"
HETEROLOG_DELIVERY_CLOUDWATCH_LOG_STREAM_NAME="local-delivery"
# none=固定名、monthly=/YYYY/MM、daily=/YYYY/MM/DD、hourly=/YYYY/MM/DD/HHを付与する
# suffixはログ発生時刻（Clock）のタイムゾーンに従い、本文表示用のlocal time/timezone設定には従わない
HETEROLOG_DELIVERY_CLOUDWATCH_LOG_STREAM_ROTATION=none
HETEROLOG_DELIVERY_CLOUDWATCH_TIMEOUT_SECOND=2
HETEROLOG_DELIVERY_CLOUDWATCH_AWS_ACCESS_KEY_ID=
HETEROLOG_DELIVERY_CLOUDWATCH_AWS_SECRET_ACCESS_KEY=
HETEROLOG_DELIVERY_CLOUDWATCH_AWS_SESSION_TOKEN=
HETEROLOG_DELIVERY_CLOUDWATCH_HEADERS={}
HETEROLOG_ENABLE_DELIVERY_CLOUDWATCH_AUTO_CREATE_LOG_STREAM=false
HETEROLOG_ENABLE_DELIVERY_CLOUDWATCH_COMPRESS_REQUEST=true
HETEROLOG_ENABLE_DELIVERY_CLOUDWATCH_PUT_LATENCY=true
# 直後の *_RETRY_CLIENT_MODE には次のいずれかを指定する（各行の「# -」直後の名前が設定値）:
# - none: raw client。retryもcircuit breakerも適用しない
# - retry: RetryingClient -> raw client。timeout・接続断・一時的なHTTPエラーなど、再試行可能と判定された失敗をMaxAttemptsまで再試行する。待機時間はBaseDelayずつ増やし、MaxDelayを上限とする
# - retry_policy: RetryPolicyClient -> raw client。恒久エラー・親context終了・breaker openは1回、timeout・EOF・接続断・HTTP 408・500・504は最大2回、HTTP 502・503・throttlingはMaxAttemptsまで試行する。429・503のRetry-Afterとcontext残時間も考慮する
# - circuit_breaker: CircuitBreakerClient -> raw client。retryは行わず、連続障害時はcooldown中の接続を抑止する
# - retry_with_breaker: RetryingClient -> CircuitBreakerClient -> raw client。RetryingClientによる各試行をbreakerが監視し、open後は残りの試行を抑止する
# - retry_policy_with_breaker: RetryPolicyClient -> CircuitBreakerClient -> raw client。RetryPolicyClientによる各試行をbreakerが監視し、open後は残りの試行を抑止する
HETEROLOG_DELIVERY_CLOUDWATCH_RETRY_CLIENT_MODE=retry_policy
# CloudWatch Logsは冪等性を保証しない。欠損回避を優先し、重複ログを許容するat-least-onceとして再送する
# circuit breakerを含むmodeではopen中の接続をskipし、cooldown後は1件だけprobeとして通す（固定動作）
# 初回の送信に加える再試行の回数。0なら再試行しません（再試行するmodeでは、負の値はエラー）
HETEROLOG_MAX_DELIVERY_CLOUDWATCH_RETRYABLE_CLIENT_RETRIES=2
# 再試行の前に待つ時間の基準と上限（ミリ秒）。再試行するmodeでは、0以下はエラー
HETEROLOG_DELIVERY_CLOUDWATCH_RETRYABLE_CLIENT_MILLISECOND=200
HETEROLOG_MAX_DELIVERY_CLOUDWATCH_RETRYABLE_CLIENT_DELAY_MILLISECOND=1000

# Loki登録失敗時のハンドリング設定
# DURABLE_TYPES=noneの場合だけ、overload判定を行わずDEGRADE_TYPESへ直接退避する
HETEROLOG_ENABLE_LOKI_DEGRADE=true
HETEROLOG_MAX_LOKI_FAILURE_HANDLER_CONCURRENT=8
HETEROLOG_LOKI_DURABLE_TYPES=spool,fileArchive
# DEGRADE_TYPESはstdoutのみ実装済み。s3,nfsは予約値で、指定すると起動時エラーになります。
HETEROLOG_LOKI_DEGRADE_TYPES=stdout
HETEROLOG_MAX_LOKI_DURABLE_FILE_ARCHIVE_SIZE_MB=50
# disable=compress/upload/purgeを実行しない（保存・rotationは継続）, inline=failure handlerで実行, runner=専用runnerで周期実行
HETEROLOG_LOKI_DURABLE_FILE_ARCHIVE_LIFECYCLE_MODE=inline
HETEROLOG_LOKI_FAILURE_ARCHIVE_DIR="loki_failure_archives"
HETEROLOG_LOKI_FAILURE_SPOOL_DIR="loki"
HETEROLOG_LOKI_ENABLE_DURABLE_FILE_ARCHIVE_ROTATE=true
# 保持世代数・保持日数・ディレクトリ上限(MB)。0は上限なしで、その条件では削除しません（既定）。
# 0以外は世代数2以上・日数1以上・上限10以上かつファイル最大サイズ以上。空き容量がHETEROLOG_MIN_AVAILABLE_DISK_SPACE_GB未満の間は、新しい失敗をarchiveへ保存せずOVERLOAD_POLICYで処理します。
HETEROLOG_MAX_LOKI_ENABLE_DURABLE_FILE_ARCHIVE_BACKUPS=0
HETEROLOG_MAX_LOKI_ENABLE_DURABLE_FILE_ARCHIVE_AGE=0
HETEROLOG_MAX_LOKI_ENABLE_DURABLE_FILE_ARCHIVE_DIR_SIZE_MB=0
HETEROLOG_ENABLE_LOKI_DURABLE_FILE_ARCHIVE_COMPRESS=true
HETEROLOG_LOKI_DURABLE_FILE_ARCHIVE_COMPRESS_FORMAT=zstd
HETEROLOG_LOKI_DURABLE_FILE_ARCHIVE_ROTATION=daily
HETEROLOG_ENABLE_LOKI_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_UPLOAD=false
HETEROLOG_LOKI_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_UPLOAD_TYPE=s3
HETEROLOG_LOKI_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_S3_BUCKET=
HETEROLOG_LOKI_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_S3_PREFIX=loki/sync/failure-archive
HETEROLOG_LOKI_DURABLE_FILE_ARCHIVE_OVERLOAD_POLICY=drop
HETEROLOG_LOKI_DURABLE_FILE_ARCHIVE_SECONDARY_DESTINATION=stdout
# failure archive自身の内部ログを通知する出力先（カンマ区切り）。
HETEROLOG_LOKI_DURABLE_FILE_ERROR_HANDLER=stdout
HETEROLOG_LOKI_DURABLE_FILE_WARN_HANDLER=stdout
HETEROLOG_LOKI_DURABLE_FILE_INFO_HANDLER=stdout
HETEROLOG_LOKI_DURABLE_FILE_DEBUG_HANDLER=stdout
HETEROLOG_LOKI_SPOOL_OVERLOAD_POLICY=drop
HETEROLOG_LOKI_SPOOL_SECONDARY_DESTINATION=stdout
HETEROLOG_MAX_LOKI_SPOOL_FILE_ACTIVE_DIR_SIZE_MB=1024
# active spoolの最古データがこの日数より古い場合にWarn通知する（保存は拒否しない。0で無効）
HETEROLOG_LOKI_ACTIVE_SPOOL_BACKLOG_WARN_AFTER_DAYS=120
HETEROLOG_MAX_LOKI_SPOOL_SCANNED_CACHE_USAGE_COUNT=100000
HETEROLOG_LOKI_SPOOL_CACHE_LIFETIME_SECOND=30
HETEROLOG_USE_MEMORY_PRESSURE_LOKI_SPOOL_OVERLOAD=false
HETEROLOG_LOKI_SPOOL_FILE_ERROR_HANDLER=stdout
HETEROLOG_LOKI_SPOOL_FILE_WARN_HANDLER=stdout
HETEROLOG_LOKI_SPOOL_FILE_INFO_HANDLER=stdout
HETEROLOG_LOKI_SPOOL_FILE_DEBUG_HANDLER=stdout

# 非同期Loki登録失敗時のハンドリング設定
# DURABLE_TYPES=noneの場合だけ、overload判定を行わずDEGRADE_TYPESへ直接退避する
HETEROLOG_ENABLE_ASYNC_LOKI_DEGRADE=true
HETEROLOG_MAX_ASYNC_LOKI_FAILURE_HANDLER_CONCURRENT=8
HETEROLOG_ASYNC_LOKI_DURABLE_TYPES=spool,fileArchive
# DEGRADE_TYPESはstdoutのみ実装済み。s3,nfsは予約値で、指定すると起動時エラーになります。
HETEROLOG_ASYNC_LOKI_DEGRADE_TYPES=stdout
