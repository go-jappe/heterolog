HETEROLOG_DELIVERY_LOG_FILE_DEBUG_OBJECT_STORAGE_S3_BUCKET=
HETEROLOG_DELIVERY_LOG_FILE_DEBUG_OBJECT_STORAGE_S3_PREFIX=

# ログにログファイル操作のレイテンシを記録する
HETEROLOG_WRITE_LOG_FILE_LATENCY_ENABLED=true
# ログファイルサンプリング　しなければ全部ログ対象
# サンプリングは未設定時は無効です（ほかの出力先とASYNC_も同じ）。有効にした場合だけ、下の割合で残すログを選びます。
HETEROLOG_ENABLE_LOG_FILE_SAMPLING=false
# リクエストID追跡でサンプリングする
HETEROLOG_ENABLE_LOGGING_FILE_BY_REQUEST_ID=true
# サンプリングレート 10なら10分の1の割合
HETEROLOG_LOG_FILE_REQUEST_ID_RATE=10
HETEROLOG_LOG_FILE_DEBUG_RATE=1
HETEROLOG_LOG_FILE_INFO_RATE=10
HETEROLOG_LOG_FILE_WARN_RATE=1
HETEROLOG_LOG_FILE_ERROR_RATE=1

