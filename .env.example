# disable=compress/upload/purgeを実行しない（保存・rotationは継続）, inline=failure handlerで実行, runner=専用runnerで周期実行
HETEROLOG_ASYNC_LOKI_DURABLE_FILE_ARCHIVE_LIFECYCLE_MODE=inline
HETEROLOG_ASYNC_LOKI_FAILURE_ARCHIVE_DIR="async_loki_failure_archives"
HETEROLOG_ASYNC_LOKI_FAILURE_SPOOL_DIR="loki_async"
HETEROLOG_ASYNC_LOKI_ENABLE_DURABLE_FILE_ARCHIVE_ROTATE=true
# 保持世代数・保持日数・ディレクトリ上限(MB)。0は上限なしで、その条件では削除しません（既定）。
# 0以外は世代数2以上・日数1以上・上限10以上かつファイル最大サイズ以上。空き容量がHETEROLOG_MIN_AVAILABLE_DISK_SPACE_GB未満の間は、新しい失敗をarchiveへ保存せずOVERLOAD_POLICYで処理します。
HETEROLOG_MAX_ASYNC_LOKI_ENABLE_DURABLE_FILE_ARCHIVE_BACKUPS=0
HETEROLOG_MAX_ASYNC_LOKI_ENABLE_DURABLE_FILE_ARCHIVE_AGE=0
HETEROLOG_MAX_ASYNC_LOKI_ENABLE_DURABLE_FILE_ARCHIVE_DIR_SIZE_MB=0
HETEROLOG_ENABLE_ASYNC_LOKI_DURABLE_FILE_ARCHIVE_COMPRESS=true
HETEROLOG_ASYNC_LOKI_DURABLE_FILE_ARCHIVE_COMPRESS_FORMAT=zstd
HETEROLOG_ASYNC_LOKI_DURABLE_FILE_ARCHIVE_ROTATION=daily
HETEROLOG_ENABLE_ASYNC_LOKI_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_UPLOAD=false
HETEROLOG_ASYNC_LOKI_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_UPLOAD_TYPE=s3
HETEROLOG_ASYNC_LOKI_DURABLE_FILE_ARCHIVE_OBJECT_STORAGE_S3_BUCKET=
