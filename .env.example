HETEROLOG_ASYNC_LOKI_DURABLE_FILE_ARCHIVE_OVERLOAD_POLICY=drop
HETEROLOG_ASYNC_LOKI_DURABLE_FILE_ARCHIVE_SECONDARY_DESTINATION=stdout
# 非同期loggerのfailure archive自身の内部ログを通知する出力先（カンマ区切り）。
HETEROLOG_ASYNC_LOKI_DURABLE_FILE_ERROR_HANDLER=stdout
HETEROLOG_ASYNC_LOKI_DURABLE_FILE_WARN_HANDLER=stdout
HETEROLOG_ASYNC_LOKI_DURABLE_FILE_INFO_HANDLER=stdout
HETEROLOG_ASYNC_LOKI_DURABLE_FILE_DEBUG_HANDLER=stdout
HETEROLOG_ASYNC_LOKI_SPOOL_OVERLOAD_POLICY=drop
HETEROLOG_ASYNC_LOKI_SPOOL_SECONDARY_DESTINATION=stdout
HETEROLOG_MAX_ASYNC_LOKI_SPOOL_FILE_ACTIVE_DIR_SIZE_MB=1024
# active spoolの最古データがこの日数より古い場合にWarn通知する（保存は拒否しない。0で無効）
HETEROLOG_ASYNC_LOKI_ACTIVE_SPOOL_BACKLOG_WARN_AFTER_DAYS=120
HETEROLOG_MAX_ASYNC_LOKI_SPOOL_SCANNED_CACHE_USAGE_COUNT=100000
HETEROLOG_ASYNC_LOKI_SPOOL_CACHE_LIFETIME_SECOND=30
HETEROLOG_USE_MEMORY_PRESSURE_ASYNC_LOKI_SPOOL_OVERLOAD=false
HETEROLOG_ASYNC_LOKI_SPOOL_FILE_ERROR_HANDLER=stdout
HETEROLOG_ASYNC_LOKI_SPOOL_FILE_WARN_HANDLER=stdout
HETEROLOG_ASYNC_LOKI_SPOOL_FILE_INFO_HANDLER=stdout
HETEROLOG_ASYNC_LOKI_SPOOL_FILE_DEBUG_HANDLER=stdout

